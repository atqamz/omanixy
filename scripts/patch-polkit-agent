#!/usr/bin/env python3
"""Narrow post-patch to the pinned PolkitAgent.qml and PolkitModel.js for the
Quattro polkit agent.

Removes upstream's PAM-file fingerprint inference and laptop-lid presentation
policy entirely: no FileView reading /etc/pam.d/polkit-1, no
omarchy-hw-laptop-closed Process, no fingerprintConfigured/laptopClosed
state, no loadPamConfig()/refreshLidState(). Omanixy does not infer, and does
not take over, the host's own polkit-1 PAM authentication policy.

The resulting waiting presentation is authentication-method-neutral: it is
driven only by the pinned Quickshell AuthFlow.isResponseRequired signal, never
by parsing PAM text or hardware lid state. The final generated QML has no
external Process.command surface at all (proven separately by
scan-polkit-executable-surface).

PolkitModel.js loses its now-unused fingerprint-detection helpers
(promptLooksFingerprint, fingerprintConfiguredFromPamConfig); only
authorizationLabel remains, unchanged.
"""

from pathlib import Path
import sys


def block(lines: list[str]) -> str:
    return "\n".join(lines) + "\n"


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{label}: expected one pinned block, found {count}")
    return text.replace(old, new, 1)


def apply_qml(text: str) -> str:
    text = replace_once(text, "import Quickshell.Io\n", "", "unused FileView/Process import")

    fingerprint_properties_old = block([
        "  // pam_fprintd appears in the polkit PAM stack (a sensor is enrolled).",
        "  property bool fingerprintConfigured: false",
        "  // Lid shut right now — the reader is physically unreachable, so we fall back",
        "  // to the password even when a sensor is enrolled. Refreshed per request.",
        "  property bool laptopClosed: false",
    ])
    text = replace_once(text, fingerprint_properties_old, "", "fingerprint/lid state properties")

    dialog_mode_old = block([
        "  readonly property bool dialogVisible: polkitAgent.isActive || closing",
        "  // We show one method at a time. Fingerprint owns the dialog while PAM is",
        "  // waiting on the reader (lid open, sensor enrolled); the moment PAM asks for",
        "  // a password — including immediately when the lid is shut and the clamshell",
        "  // gate skips pam_fprintd — we switch to the password field instead.",
        "  readonly property bool fingerprintMode: fingerprintConfigured && !laptopClosed && dialogVisible && !responseRequired && !submitted && !errorFlash",
    ])
    dialog_mode_new = block([
        "  readonly property bool dialogVisible: polkitAgent.isActive || closing",
        "  // Generic waiting presentation while PAM has not yet asked for a response.",
        "  // The backend method is not assumed here (fingerprint, smartcard, another",
        "  // PAM module, or a transient noninteractive phase all look the same).",
        "  readonly property bool waitingForAuthentication: dialogVisible && !responseRequired && !submitted && !errorFlash",
    ])
    text = replace_once(text, dialog_mode_old, dialog_mode_new, "dialog/waiting mode property")

    card_width_old = block([
        "  // Password mode is a wide field; fingerprint mode collapses to a square that",
        "  // just frames the centered sensor icon.",
        "  readonly property int cardWidth: fingerprintMode ? cardHeight : Math.min(Style.space(312), Math.max(Style.space(260), panel.width - Style.gapsOut * 2))",
    ])
    card_width_new = block([
        "  // Password mode is a wide field; the waiting presentation collapses to a",
        "  // square that just frames the centered authentication icon.",
        "  readonly property int cardWidth: waitingForAuthentication ? cardHeight : Math.min(Style.space(312), Math.max(Style.space(260), panel.width - Style.gapsOut * 2))",
    ])
    text = replace_once(text, card_width_old, card_width_new, "card width property")

    pam_functions_old = block([
        "  function loadPamConfig(raw) {",
        "    fingerprintConfigured = PolkitModel.fingerprintConfiguredFromPamConfig(raw)",
        "  }",
        "",
        "  function refreshLidState() {",
        "    if (!laptopClosedProc.running) laptopClosedProc.running = true",
        "  }",
        "",
    ])
    text = replace_once(text, pam_functions_old, "", "loadPamConfig/refreshLidState functions")

    begin_flow_old = block([
        '    passwordInput.text = ""',
        "    refreshLidState()",
        "    syncFromFlow()",
    ])
    begin_flow_new = block([
        '    passwordInput.text = ""',
        "    syncFromFlow()",
    ])
    text = replace_once(text, begin_flow_old, begin_flow_new, "beginFlow refreshLidState call")

    refocus_old = block([
        "  function refocus() {",
        "    if (!dialogVisible) return",
        "    // In fingerprint mode there is no field to type into — park focus on the",
        "    // key catcher so Escape still cancels; otherwise focus the password field.",
        "    if (fingerprintMode) keyCatcher.forceActiveFocus()",
        "    else passwordInput.forceActiveFocus()",
        "  }",
    ])
    refocus_new = block([
        "  function refocus() {",
        "    if (!dialogVisible) return",
        "    // While waiting for authentication there is no field to type into — park",
        "    // focus on the key catcher so Escape still cancels; otherwise focus the",
        "    // password field.",
        "    if (waitingForAuthentication) keyCatcher.forceActiveFocus()",
        "    else passwordInput.forceActiveFocus()",
        "  }",
    ])
    text = replace_once(text, refocus_old, refocus_new, "refocus function")

    pam_fileview_and_lid_process_old = block([
        "  FileView {",
        '    path: "/etc/pam.d/polkit-1"',
        "    watchChanges: true",
        "    printErrors: false",
        "    onLoaded: root.loadPamConfig(text())",
        "    onLoadFailed: root.fingerprintConfigured = false",
        "    onFileChanged: reload()",
        "  }",
        "",
        "  Process {",
        "    id: laptopClosedProc",
        '    command: ["bash", "-c", "omarchy-hw-laptop-closed && echo closed || echo open"]',
        "    stdout: StdioCollector { id: laptopClosedOut; waitForEnd: true }",
        '    onExited: root.laptopClosed = String(laptopClosedOut.text || "").trim() === "closed"',
        "  }",
    ])
    text = replace_once(text, pam_fileview_and_lid_process_old, "", "PAM fileview and lid-state process")

    optical_glyph_old = block([
        "      // Fingerprint mode shows just the sensor icon, centered and alone \\u2014 no",
        "      // padlock, no field, no prompt text.",
        "      OpticalGlyph {",
        "        anchors.centerIn: parent",
        "        width: Math.round(root.fieldHeight * 0.7)",
        "        height: width",
        "        visible: root.fingerprintMode",
        '        text: "\\udb80\\ude37"',
        "        fontFamily: root.fontFamily",
        "        fontSize: Math.round(root.fieldHeight * 0.7)",
        "        color: root.errorFlash ? Color.polkit.textError : root.accent",
        "      }",
    ])
    optical_glyph_new = block([
        "      // The waiting presentation shows just a generic authentication icon,",
        "      // centered and alone — no field, no prompt text. The backend method is",
        "      // not assumed (fingerprint, smartcard, another PAM module, or a",
        "      // transient noninteractive phase all look the same here).",
        "      OpticalGlyph {",
        "        anchors.centerIn: parent",
        "        width: Math.round(root.fieldHeight * 0.7)",
        "        height: width",
        "        visible: root.waitingForAuthentication",
        '        text: "\\uf023"',
        "        fontFamily: root.fontFamily",
        "        fontSize: Math.round(root.fieldHeight * 0.7)",
        "        color: root.errorFlash ? Color.polkit.textError : root.accent",
        "      }",
    ])
    text = replace_once(text, optical_glyph_old, optical_glyph_new, "waiting-mode glyph")

    row_visible_old = "        visible: !root.fingerprintMode"
    row_visible_new = "        visible: !root.waitingForAuthentication"
    text = replace_once(text, row_visible_old, row_visible_new, "input row visibility")

    return text


def apply_js(text: str) -> str:
    prompt_looks_fingerprint_old = block([
        "function promptLooksFingerprint(text) {",
        '  var s = String(text || "").toLowerCase()',
        '  return s.indexOf("finger") !== -1 || s.indexOf("fprint") !== -1 || s.indexOf("swipe") !== -1',
        "}",
        "",
    ])
    text = replace_once(text, prompt_looks_fingerprint_old, "", "promptLooksFingerprint helper")

    fingerprint_configured_old = block([
        "function fingerprintConfiguredFromPamConfig(raw) {",
        "  // Fingerprint is available whenever pam_fprintd appears anywhere in the auth",
        "  // stack — it need not be the first module. A clamshell gate (pam_exec) may",
        "  // legitimately precede it to skip fingerprint while the lid is closed.",
        '  var lines = String(raw || "").split("\\n")',
        "  for (var i = 0; i < lines.length; i++) {",
        '    var line = lines[i].replace(/^\\s+|\\s+$/g, "")',
        '    if (!line || line.charAt(0) === "#") continue',
        "    if (!line.match(/^auth\\s+/)) continue",
        '    if (line.indexOf("pam_fprintd.so") !== -1) return true',
        "  }",
        "  return false",
        "}",
        "",
    ])
    text = replace_once(text, fingerprint_configured_old, "", "fingerprintConfiguredFromPamConfig helper")

    exports_old = block([
        "  module.exports = {",
        "    promptLooksFingerprint: promptLooksFingerprint,",
        "    fingerprintConfiguredFromPamConfig: fingerprintConfiguredFromPamConfig,",
        "    authorizationLabel: authorizationLabel",
        "  }",
    ])
    exports_new = block([
        "  module.exports = {",
        "    authorizationLabel: authorizationLabel",
        "  }",
    ])
    text = replace_once(text, exports_old, exports_new, "module.exports surface")

    return text


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(f"usage: {sys.argv[0]} POLKIT_AGENT_QML POLKIT_MODEL_JS", file=sys.stderr)
        return 2

    qml_path = Path(argv[0])
    qml_path.write_text(apply_qml(qml_path.read_text()))

    js_path = Path(argv[1])
    js_path.write_text(apply_js(js_path.read_text()))

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
