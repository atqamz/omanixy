#!/usr/bin/env python3
"""Inventory the static contracts exposed by the pinned Quattro source."""

from __future__ import annotations

import hashlib
import json
import re
import sys
from pathlib import Path

import source_discovery


TEXT_SUFFIXES = {".qml", ".js", ".sh"}

# Every file recursively found under these roots is a security source: the
# roots are the allowlist, never the individual files inside them. Adding,
# removing, renaming, or editing a file under a root changes the snapshot
# even when it matches no recognized pattern.
SECURITY_SOURCE_ROOTS = (
    "shell/plugins/lock/",
    "shell/plugins/polkit/",
    "shell/plugins/services/idle/",
    "shell/plugins/notifications/",
)

# omarchy-* helpers reached from a security source or an already-audited
# security helper. Every helper the scanner discovers by traversal must have
# exactly one disposition here or the drift-checkable output records it
# unresolved: unresolved.length must be zero for the audit to pass.
#
# Only "audited-source" edges are traversed further; every other disposition
# is a deliberate stop: the edge is recorded and hashed evidence is not
# claimed beyond it.
SECURITY_HELPER_DISPOSITIONS = {
    "bin/omarchy-apply-lock": "audited-source",
    "bin/omarchy-system-lock": "audited-source",
    "bin/omarchy-system-wake": "audited-source",
    "bin/omarchy-hyprland-session-locked": "audited-source",
    "bin/omarchy-brightness-keyboard": "audited-source",
    "bin/omarchy-brightness-display": "audited-source",
    "bin/omarchy-brightness-display-apple": "audited-source",
    "bin/omarchy-brightness-display-ddc": "audited-source",
    "bin/omarchy-hyprland-monitor-clamshell": "audited-source",
    "bin/omarchy-hyprland-monitor-external-active": "audited-source",
    "bin/omarchy-hyprland-monitor-focused": "audited-source",
    "bin/omarchy-hyprland-monitor-focused-apple": "audited-source",
    "bin/omarchy-hyprland-monitor-internal": "audited-source",
    "bin/omarchy-hyprland-monitor-internal-mirror": "audited-source",
    "bin/omarchy-hyprland-monitor-laptop": "audited-source",
    "bin/omarchy-hw-laptop-closed": "audited-source",
    "bin/omarchy-hw-clamshell": "audited-source",
    "bin/omarchy-hw-display": "audited-source",
    "bin/omarchy-hw-external-monitors": "audited-source",
    "bin/omarchy-hyprland-focus-app": "audited-source",
    "bin/omarchy-launch-screensaver": "audited-source",
    "bin/omarchy-hyprland-toggle": "audited-source",
    "bin/omarchy-hyprland-toggle-enabled": "audited-source",
    "bin/omarchy-hyprland-toggle-disabled": "audited-source",
    "bin/omarchy-notification-send": "existing-omanixy-capability",
    "bin/omarchy-shell": "existing-omanixy-capability",
    "bin/omarchy-cmd-present": "incidental-upstream-policy-omitted",
    "bin/omarchy-cmd-missing": "incidental-upstream-policy-omitted",
    "bin/omarchy-toggle-enabled": "incidental-upstream-policy-omitted",
    "bin/omarchy-osd": "presentation-only-unreachable",
    "bin/omarchy-lock-fingerprint": "not-an-invocation",
}
SECURITY_HELPER_SEEDS = ("bin/omarchy-apply-lock",)
TRAVERSABLE_HELPER_DISPOSITIONS = {"audited-source"}

MENU_FIELDS = ("action", "when", "checked", "provider")
ENV_RE = re.compile(r"\$(?:\{)?([A-Z][A-Z0-9_]*)(?:\})?")
HELPER_RE = re.compile(r"(?<![A-Za-z0-9_-])(omarchy-[a-z0-9][a-z0-9-]*)(?![A-Za-z0-9_-])")
ABSOLUTE_HELPER_RE = re.compile(
    r"(?:\$OMARCHY_PATH|\bomarchyPath\b)[^\n]*?/bin/(omarchy-[a-z0-9][a-z0-9-]*)"
)
ENV_CALL_RE = re.compile(r"\.env\(\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']\s*\)")
IMPORT_RE = re.compile(r"^\s*import\s+(Quickshell(?:\.[A-Za-z0-9_.]+)?)\b", re.MULTILINE)
SERVICE_RE = re.compile(
    r"(?:NetworkManager|BlueZ|UPower|MPRIS|PipeWire|WirePlumber|"
    r"power-profiles-daemon|WlSessionLock|org\.[A-Za-z0-9_.-]+)"
)
SECURITY_RE = re.compile(
    r"(?:/etc/pam\.d/[A-Za-z0-9_.-]+|WlSessionLock|polkit|"
    r"org\.freedesktop\.Notifications|org\.freedesktop\.PolicyKit1)"
)

DYNAMIC_EXECUTABLE = source_discovery.DYNAMIC_EXECUTABLE


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def strip_comments(text: str, shell: bool = False) -> str:
    """Strip comments for line-oriented scanning.

    Shell has no block-comment syntax, so treating "/*" as a QML/JS block
    comment opener would eat glob patterns like "image/*)" in a case arm.
    Shell scripts strip only unquoted "#" to end of line instead.
    """

    result: list[str] = []
    block = False
    for line in text.splitlines(keepends=True):
        out: list[str] = []
        quote = ""
        index = 0
        while index < len(line):
            if shell:
                if not quote and line[index] == "#":
                    newline = "\n" if line.endswith("\n") else ""
                    out.append(newline)
                    break
            else:
                if block:
                    end = line.find("*/", index)
                    if end < 0:
                        index = len(line)
                        break
                    block = False
                    index = end + 2
                    continue
                if not quote and line.startswith("/*", index):
                    block = True
                    index += 2
                    continue
                if not quote and line.startswith("//", index):
                    newline = "\n" if line.endswith("\n") else ""
                    out.append(newline)
                    break
            char = line[index]
            if char in "\"'`":
                if quote == char:
                    quote = ""
                elif not quote:
                    quote = char
            out.append(char)
            index += 1
        result.append("".join(out))
    return "".join(result)


def line_number(text: str, offset: int) -> int:
    return text.count("\n", 0, offset) + 1


def record(path: str, line: int, name: str, **extra: object) -> dict[str, object]:
    return {"name": name, "path": path, "line": line, **extra}


def shell_command_line(line: str) -> str:
    """Strip a leading assignment, function opener, or case arm from a shell line."""

    stripped = re.sub(r"^\s*[A-Za-z_][A-Za-z0-9_]*(?:\[[^]]+\])?=", "", line)
    function_body = re.match(r"^\s*[A-Za-z_][A-Za-z0-9_]*\s*\(\s*\)\s*\{", line)
    if function_body:
        return line[function_body.end():]
    case_arm = re.match(r"^\s*[^;&]+\)\s*", line)
    if case_arm:
        return line[case_arm.end():]
    return stripped


def scan_shell_names(text: str) -> list[tuple[str, int, str]]:
    """Discover every command head (helper or external) in shell script text."""

    shell_functions = {
        match.group(1)
        for match in re.finditer(
            r"^\s*(?:function\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*\(\s*\)\s*\{",
            text,
            re.MULTILINE,
        )
    }
    found: list[tuple[str, int, str]] = []
    for line_index, line in enumerate(text.splitlines(), 1):
        for name in source_discovery.shell_executables(shell_command_line(line)):
            if name not in shell_functions:
                found.append((name, line_index, line.strip()))
        for match in source_discovery.COMMAND_SUBSHELL_RE.finditer(line):
            for name in source_discovery.shell_executables(match.group(1)):
                if name not in shell_functions:
                    found.append((name, line_index, line.strip()))
        for match in source_discovery.PROCESS_SUBSHELL_RE.finditer(line):
            for name in source_discovery.shell_executables(match.group(1)):
                if name not in shell_functions:
                    found.append((name, line_index, line.strip()))
    return found


def parse_menu(path: Path, root: Path) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
    raw = path.read_text()
    stripped = re.sub(r"^\s*//[^\n]*(?:\n|$)", "", raw, flags=re.MULTILINE)
    stripped = re.sub(r",(\s*[}\]])", r"\1", stripped)
    data = json.loads(stripped)
    entries = data.get("items", data) if isinstance(data, dict) else {}
    menu_commands: list[dict[str, object]] = []
    helpers: list[dict[str, object]] = []
    relative = str(path.relative_to(root))
    for item_id in sorted(entries):
        item = entries[item_id]
        if not isinstance(item, dict):
            continue
        for field in MENU_FIELDS:
            value = item.get(field)
            if not isinstance(value, str) or not value:
                continue
            menu_commands.append(record(relative, 0, value, field=field, id=item_id))
            for command in source_discovery.shell_executables(value):
                if command.startswith("omarchy-"):
                    helpers.append(record(relative, 0, command, invocation=f"menu.{field}", id=item_id))
    return menu_commands, helpers


def collect_line_contracts(
    relative: str,
    line_index: int,
    line: str,
    environments: set[str],
    filesystem: list[dict[str, object]],
    services: list[dict[str, object]],
    security: list[dict[str, object]],
) -> None:
    for variable in ENV_RE.findall(line):
        environments.add(variable)
    for match in ENV_CALL_RE.finditer(line):
        environments.add(match.group(1))

    for match in SERVICE_RE.finditer(line):
        services.append(record(relative, line_index, match.group(0)))
    for match in SECURITY_RE.finditer(line):
        security.append(record(relative, line_index, match.group(0)))

    path_matches = re.findall(
        r"(?:\$OMARCHY_PATH[^\s\"']*|\$HOME[^\s\"']*|\$XDG_[A-Z_]+[^\s\"']*|"
        r"/etc/[A-Za-z0-9_./-]+|/sys/[A-Za-z0-9_./-]+|/proc/[A-Za-z0-9_./-]+)",
        line,
    )
    path_matches.extend(
        f"omarchyPath + {suffix}"
        for suffix in re.findall(
            r"(?:\b(?:root|service)\.omarchyPath\b|\bomarchyPath\b)\s*\+\s*[\"']([^\"']+)",
            line,
        )
    )
    path_matches.extend(
        f"{variable} + {suffix}"
        for variable, suffix in re.findall(
            r"Quickshell\.env\(\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']\s*\)\s*\+\s*[\"']([^\"']+)",
            line,
        )
    )
    for value in path_matches:
        kind = "watch" if "watchChanges" in line or "onFileChanged" in line else "read"
        if any(token in line for token in ("setText", "atomicWrites", "mkdir", "install", "mv", "rm ", " > ", " >> ")):
            kind = "write"
        filesystem.append(record(relative, line_index, value, kind=kind))


def collect_security_source_files(root: Path) -> list[dict[str, object]]:
    files: list[dict[str, object]] = []
    for source_root in SECURITY_SOURCE_ROOTS:
        root_dir = root / source_root
        if not root_dir.is_dir():
            continue
        for file_path in sorted(p for p in root_dir.rglob("*") if p.is_file()):
            relative = str(file_path.relative_to(root))
            files.append(
                {
                    "path": relative,
                    "root": source_root,
                    "present": True,
                    "hash": sha256_bytes(file_path.read_bytes()),
                }
            )
    return files


def collect_security_helper_edges(
    root: Path,
    seed_names: set[str],
    environments: set[str],
    filesystem: list[dict[str, object]],
    services: list[dict[str, object]],
    security: list[dict[str, object]],
) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
    """Traverse the omarchy-* helper graph reached from security sources.

    Returns (helper_edges, external_executables_from_helpers). Only edges
    dispositioned as audited-source are traversed further; every other
    disposition is a deliberate stop. Traversed files feed the same
    environment/filesystem/service/security contract collections as
    QML/JS sources, so an audited helper's contracts are not lost.
    """

    edges: dict[str, dict[str, object]] = {}
    externals: list[dict[str, object]] = []
    queue = sorted({f"bin/{name}" for name in seed_names} | set(SECURITY_HELPER_SEEDS))
    while queue:
        relative = queue.pop(0)
        if relative in edges:
            continue
        name = relative.rsplit("/", 1)[-1]
        file_path = root / relative
        present = file_path.is_file()
        disposition = SECURITY_HELPER_DISPOSITIONS.get(relative)
        entry: dict[str, object] = {
            "path": relative,
            "name": name,
            "disposition": disposition,
            "present": present,
        }
        if disposition is not None and present:
            entry["hash"] = sha256_bytes(file_path.read_bytes())
        edges[relative] = entry
        if disposition in TRAVERSABLE_HELPER_DISPOSITIONS and present:
            text = strip_comments(file_path.read_text(errors="replace"), shell=True)
            for line_index, line in enumerate(text.splitlines(), 1):
                collect_line_contracts(relative, line_index, line, environments, filesystem, services, security)
            for found_name, found_line, shape in scan_shell_names(text):
                if found_name == DYNAMIC_EXECUTABLE:
                    continue
                if found_name.startswith("omarchy-"):
                    queue.append(f"bin/{found_name}")
                else:
                    externals.append(record(relative, found_line, found_name, invocation="helper-shell"))
    return sorted(edges.values(), key=lambda item: item["path"]), sorted(
        externals, key=lambda item: (item["name"], item["path"], item["line"])
    )


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} SOURCE", file=sys.stderr)
        return 2

    root = Path(sys.argv[1]).resolve()
    if not root.is_dir() or not (root / "shell").is_dir():
        print(f"source does not contain shell/: {root}", file=sys.stderr)
        return 2

    direct_commands: list[dict[str, object]] = []
    helpers: list[dict[str, object]] = []
    absolute_helpers: list[dict[str, object]] = []
    external: list[dict[str, object]] = []
    dynamic: list[dict[str, object]] = []
    filesystem: list[dict[str, object]] = []
    environments: set[str] = set()
    imports: set[str] = set()
    services: list[dict[str, object]] = []
    security: list[dict[str, object]] = []
    menu_commands: list[dict[str, object]] = []

    security_source_files = collect_security_source_files(root)
    security_paths = {entry["path"] for entry in security_source_files}

    source_files = sorted(
        {
            *(
                path
                for path in (root / "shell").rglob("*")
                if path.is_file() and path.suffix in TEXT_SUFFIXES
            ),
            *(
                path
                for path in (root / "config/omarchy").glob("shell.json")
                if path.is_file()
            ),
        }
    )
    for path in source_files:
        relative = str(path.relative_to(root))
        raw = path.read_text(errors="replace")
        text = strip_comments(raw, shell=relative.endswith(".sh"))
        lines = text.splitlines()

        for match in IMPORT_RE.finditer(text):
            imports.add(match.group(1))

        for line_index, line in enumerate(lines, 1):
            collect_line_contracts(relative, line_index, line, environments, filesystem, services, security)

            if re.search(r"\bcommand\s*[:=]\s*(?!\[\s*\])", line) and not re.search(r"\bcommand\s*[:=]\s*\[", line):
                expression = re.split(r"\bcommand\s*[:=]", line, maxsplit=1)[1].strip()
                if expression:
                    dynamic.append(record(relative, line_index, expression, invocation="dynamic"))
            if re.search(r"(?:Quickshell|Util)\.exec(?:Detached)?\(\s*[A-Za-z_]", line):
                dynamic.append(record(relative, line_index, line.strip(), invocation="dynamic"))
            if re.search(r"\bcommand\s*[:=].*\?", line) or re.search(r"(?:Quickshell|Util)\.exec(?:Detached)?\(\s*[A-Za-z_]", line):
                for command_match in re.finditer(r"\[\s*[\"']([^\"']+)", line):
                    name = command_match.group(1)
                    if name.startswith("omarchy-"):
                        helpers.append(record(relative, line_index, name, invocation="dynamic"))
                    elif not name.startswith(("$", "/")):
                        external.append(record(relative, line_index, name, invocation="dynamic"))

            if re.search(
                r"\bcommand\s*[:=].*\[\s*[\"'](?:bash|sh)[\"']\s*,\s*[\"']-(?:l)?c[\"']",
                line,
            ):
                dynamic.append(record(relative, line_index, line.strip(), invocation="shell-eval"))

            for match in re.finditer(r"\[\s*[\"'](omarchy-[a-z0-9][a-z0-9-]*)[\"']", line):
                helpers.append(record(relative, line_index, match.group(1), invocation="command-array"))

            for match in re.finditer(
                r"(?:\bbar\.run|(?:Quickshell|Util)\.exec(?:Detached)?)\(\s*"
                r"([\"'])(.*?)(?<!\\)\1",
                line,
            ):
                payload = match.group(2)
                local_functions = set(re.findall(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*\(\)\s*\{", payload))
                for command in source_discovery.shell_executables(payload):
                    if command in local_functions:
                        continue
                    if command == DYNAMIC_EXECUTABLE:
                        dynamic.append(record(relative, line_index, line.strip(), invocation="shell-string"))
                        continue
                    entry = record(relative, line_index, command, invocation="shell-string")
                    direct_commands.append(entry)
                    if command.startswith("omarchy-"):
                        helpers.append(entry)
                    elif not command.startswith(("$", "/")):
                        external.append(entry)

            for match in HELPER_RE.finditer(line):
                command_context = "\n".join(lines[max(0, line_index - 3):line_index])
                if any(token in command_context for token in ("command", "execDetached", "exec(", "bar.run", "runProcess", "/bin/")):
                    helpers.append(record(relative, line_index, match.group(1), invocation="source"))

        if relative.endswith(".sh"):
            for name, found_line, shape in scan_shell_names(text):
                if name == DYNAMIC_EXECUTABLE:
                    dynamic.append(record(relative, found_line, shape, invocation="shell-script"))
                    continue
                entry = record(relative, found_line, name, invocation="shell-script")
                if name.startswith("omarchy-"):
                    helpers.append(entry)
                else:
                    external.append(entry)

        for match in ABSOLUTE_HELPER_RE.finditer(text):
            absolute_helpers.append(record(relative, line_number(text, match.start()), match.group(1), form="OMARCHY_PATH/bin"))

        for match in re.finditer(
            r"(?:\bcommand\s*[:=]\s*|(?:Quickshell|Util)\.exec(?:Detached)?\s*\(\s*|"
            r"Util\.exec\s*\(\s*|bar\.run\s*\(\s*)\[\s*[\"']([^\"']+)",
            text,
            re.DOTALL,
        ):
            name = match.group(1)
            entry = record(relative, line_number(text, match.start()), name, invocation="literal")
            direct_commands.append(entry)
            if name.startswith("omarchy-"):
                helpers.append(record(relative, line_number(text, match.start()), name, invocation="literal"))
            elif not name.startswith(("$", "/")):
                external.append(entry)

    for menu_path in (
        root / "default/omarchy/omarchy-menu.jsonc",
        root / "config/omarchy/extensions/omarchy-menu.jsonc",
    ):
        if not menu_path.is_file():
            continue
        commands, menu_helpers = parse_menu(menu_path, root)
        menu_commands.extend(commands)
        helpers.extend(menu_helpers)
        for entry in commands:
            if entry["field"] != "provider":
                for command in source_discovery.shell_executables(str(entry["name"])):
                    if command != DYNAMIC_EXECUTABLE and not command.startswith(("omarchy-", "$", "/")):
                        external.append(record(entry["path"], entry["line"], command, invocation=f"menu.{entry['field']}"))

    helpers.extend(absolute_helpers)

    security_seed_names = {
        entry["name"]
        for entry in helpers
        if entry["path"] in security_paths and str(entry["name"]).startswith("omarchy-")
    }
    security_helper_edges, security_helper_externals = collect_security_helper_edges(
        root, security_seed_names, environments, filesystem, services, security
    )
    security_helper_paths = {edge["path"] for edge in security_helper_edges}

    security_helpers = [entry for entry in helpers if entry["path"] in security_paths]
    security_executables = [entry for entry in external if entry["path"] in security_paths] + security_helper_externals
    security_filesystem = [
        entry for entry in filesystem if entry["path"] in security_paths or entry["path"] in security_helper_paths
    ]
    security_direct_commands = [entry for entry in direct_commands if entry["path"] in security_paths]
    result = {
        "schema": 3,
        "roots": [
            "shell/shell.qml",
            "shell/services/",
            "shell/plugins/",
            "config/omarchy/shell.json",
            "config/omarchy/extensions/omarchy-menu.jsonc",
            "default/omarchy/omarchy-menu.jsonc",
        ],
        "direct_shell_commands": sorted(direct_commands, key=lambda item: (item["path"], item["line"], item["name"])),
        "direct_omarchy_helpers": sorted(helpers, key=lambda item: (item["name"], item["path"], item["line"], item.get("invocation", ""))),
        "absolute_helper_paths": sorted(absolute_helpers, key=lambda item: (item["name"], item["path"], item["line"])),
        "external_executables": sorted(external, key=lambda item: (item["name"], item["path"], item["line"])),
        "dynamic_commands": sorted(dynamic, key=lambda item: (item["path"], item["line"], item["name"])),
        "menu_commands": sorted(menu_commands, key=lambda item: (item["path"], item["id"], item["field"])),
        "filesystem_contracts": sorted(filesystem, key=lambda item: (item["name"], item["path"], item["line"], item["kind"])),
        "environment_variables": sorted(environments),
        "native_quickshell_modules": sorted(imports),
        "service_contracts": sorted(services, key=lambda item: (item["name"], item["path"], item["line"])),
        "security_contracts": sorted(security, key=lambda item: (item["name"], item["path"], item["line"])),
        "security_source_roots": list(SECURITY_SOURCE_ROOTS),
        "security_source_files": sorted(security_source_files, key=lambda item: item["path"]),
        "security_helper_edges": security_helper_edges,
        "security_direct_shell_commands": sorted(
            security_direct_commands,
            key=lambda item: (item["path"], item["line"], item["name"]),
        ),
        "security_helpers": sorted(
            security_helpers,
            key=lambda item: (item["name"], item["path"], item["line"], item.get("invocation", "")),
        ),
        "security_external_executables": sorted(
            security_executables,
            key=lambda item: (item["name"], item["path"], item["line"]),
        ),
        "security_filesystem_contracts": sorted(
            security_filesystem,
            key=lambda item: (item["name"], item["path"], item["line"], item["kind"]),
        ),
    }
    json.dump(result, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
