#!/usr/bin/env python3

from pathlib import Path
import sys


EXPECTED = '      if (button === Qt.RightButton) root.bar.run("xdg-terminal-exec")'
REPLACEMENT = "      if (button === Qt.RightButton) return"


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} FILE", file=sys.stderr)
        return 2
    path = Path(sys.argv[1])
    text = path.read_text(encoding="utf-8")
    count = text.count(EXPECTED)
    if count != 1:
        raise SystemExit(f"expected exactly one pinned terminal provider action, found {count}")
    path.write_text(text.replace(EXPECTED, REPLACEMENT, 1), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
