HEADLESS_TEXT_PATCHES = {
    "omarchy-network-password": (
        '  property string iface: ""',
        '  property string iface: "wlan0"',
    ),
}


def main() -> int:
    if len(sys.argv) != 5:
        print(f"usage: {sys.argv[0]} ROOT COMPATIBILITY_BIN QUICKSHELL MAPPING_JSON", file=sys.stderr)
        return 2

    root = Path(sys.argv[1])
    compatibility_bin = Path(sys.argv[2])
    quickshell = Path(sys.argv[3])
    mapping = json.loads(sys.argv[4])
    if not isinstance(mapping, dict):
        fail("consumer mapping is not an object")

    surface = {}
    (compatibility_bin / "qs").symlink_to(root / "shell")
    for helper, declaration in sorted(mapping.items()):
        if not isinstance(declaration, dict):
            fail(f"{helper} has an invalid consumer declaration")
        consumer = declaration.get("consumer")
        if not isinstance(consumer, str) or not consumer:
            fail(f"{helper} has no post-patch consumer")
        consumer_path = root / consumer
        if consumer_path.is_dir():
            candidates = sorted(
                path
                for path in consumer_path.rglob("*")
                if path.is_file() and path.suffix in {".qml", ".js", ".json", ".jsonc"}
            )
            if helper == "omarchy-shell":
                candidates = [root / "shell/shell.qml"]
            else:
                candidates = [path for path in candidates if path.suffix == ".qml" and helper.encode() in path.read_bytes()]
            if helper == "omarchy-capture-screenshot" and not candidates:
                candidates = [root / "shell/plugins/menu/Menu.qml"]
            if not candidates:
                fail(f"{helper} has no file consumer under {consumer}")
            consumer_path = candidates[0]
            consumer = str(consumer_path.relative_to(root))
        if not consumer_path.is_file():
            fail(f"{helper} consumer is missing: {consumer}")
        source = consumer_path.read_bytes()
        if helper not in {"omarchy-shell", "omarchy-capture-screenshot"} and helper.encode() not in source:
            fail(f"{helper} is not referenced by generated consumer {consumer}")
        consumer_sources = [{
            "path": consumer,
            "sha256": hashlib.sha256(source).hexdigest(),
        }]
        if helper == "omarchy-capture-screenshot":
            menu_config_path = root / "default/omarchy/omarchy-menu.jsonc"
            if not menu_config_path.is_file():
                fail("omarchy-capture-screenshot pinned menu action is missing")
            menu_config = menu_config_path.read_bytes()
            if helper.encode() not in menu_config:
                fail("omarchy-capture-screenshot pinned menu action drifted")
            consumer_sources.append({
                "path": str(menu_config_path.relative_to(root)),
                "sha256": hashlib.sha256(menu_config).hexdigest(),
            })

        helper_path = compatibility_bin / "bin" / helper
        dispatcher_path = compatibility_bin / "bin" / "omanixy-compat-adapter"
        if helper == "omarchy-shell":
            if not helper_path.is_symlink() or not dispatcher_path.is_symlink():
                fail(f"{helper} does not use the packaged compatibility dispatcher")
            surface[helper] = {
                "consumer": consumer,
                "consumerSourceSha256": hashlib.sha256(source).hexdigest(),
                "consumerSources": consumer_sources,
                "helperTarget": str(helper_path.resolve()),
                "helperTargetSha256": hashlib.sha256(helper_path.resolve().read_bytes()).hexdigest(),
                "dispatcherTarget": str(dispatcher_path.resolve()),
                "dispatcherTargetSha256": hashlib.sha256(dispatcher_path.resolve().read_bytes()).hexdigest(),
                "consumerProbe": {
                    "helper": helper,
                    "invocation": "reference-only",
                    "evidence": "test/ipc-wrapper.sh",
                },
            }
            continue

        probe_name = f"omanixy-consumer-{helper}"
        probe_path = compatibility_bin / "bin" / probe_name
        harness_path = compatibility_bin / "bin" / f"{probe_name}.qml"
        probe_root = compatibility_bin / "probes" / helper
        probe_qs = probe_root / "qs"
        probe_bin = probe_root / "bin"
        probe_qs.mkdir(parents=True, exist_ok=True)
        probe_bin.mkdir(parents=True, exist_ok=True)
        for module in ("Commons", "Ui"):
            shutil.copytree(root / "shell" / module, probe_qs / module)
        keyboard_panel = probe_qs / "Ui" / "KeyboardPanel.qml"
        keyboard_panel.chmod(stat.S_IRUSR | stat.S_IWUSR)
        keyboard_panel.write_text(HEADLESS_KEYBOARD_PANEL, encoding="utf-8")
        for path in (root / "bin").iterdir():
            if path.name in mapping:
                continue
            target = probe_bin / path.name
            if not target.exists():
                target.symlink_to(path)
        for path in (compatibility_bin / "bin").iterdir():
            if path.name not in mapping:
                continue
            target = probe_bin / path.name
            if not target.exists():
                target.symlink_to(path)
        backend_path = probe_bin / "omanixy-probe-backend"
        backend_path.write_text(
            "#!/bin/sh\n"
            "set -eu\n"
            "case ${0##*/} in\n"
            "  pw-dump) printf '%s\\n' '[{\"id\":1,\"type\":\"PipeWire:Interface:Node\",\"info\":{\"props\":{\"media.class\":\"Audio/Sink\",\"node.name\":\"probe-sink\"}}},{\"id\":1,\"type\":\"PipeWire:Interface:Node\",\"info\":{\"props\":{\"media.class\":\"Audio/Source\",\"node.name\":\"probe-source\"}}}]' ;;\n"
            "  pactl) case ${1:-} in get-default-sink) printf '%s\\n' probe-sink ;; get-default-source) printf '%s\\n' probe-source ;; esac ;;\n"
            "  wpctl) if [ \"${1:-}\" = inspect ]; then printf '%s\\n' 'node.name = \"probe-sink\"'; fi ;;\n"
            "  nmcli) nmcli_state=\"${XDG_RUNTIME_DIR:-/tmp}/omanixy-probe-nmcli-band\"; case \"$*\" in *'DEVICE,TYPE,STATE device status'*) printf '%s\\n' 'wlp0s20f3:wifi:connected' 'CloudflareWARP:tun:connected' 'tailscale0:tun:connected' 'lo:loopback:connected' 'p2p-dev-wlp0s20f3:wifi-p2p:disconnected' ;; *'GENERAL.STATE device show'*) printf '%s\\n' '100 (connected)' ;; *'GENERAL.CONNECTION device show'*) printf '%s\\n' 'probe-network' ;; *'FREQ,SSID device wifi list'*) printf '%s\\n' '2412:probe-network' '5180:probe-network' ;; *'connection modify'*) last=; for arg do last=$arg; done; printf '%s\\n' \"$last\" > \"$nmcli_state\" ;; *'connection up'*) : ;; *'802-11-wireless.band connection show'*) if [ -r \"$nmcli_state\" ]; then cat \"$nmcli_state\"; fi ;; *) printf '%s\\n' 'probe:wlan0:yes:connected:192.0.2.1/24:192.0.2.254' ;; esac ;;\n"
            "  qrencode) printf '%s\\n' probe-qr ;;\n"
            "  bluetoothctl) if [ \"${1:-}\" = list ]; then printf '%s\\n' 'Controller 00:11:22:33:44:55 probe'; elif [ \"${1:-}\" = show ]; then printf '%s\\n' 'Powered: yes'; fi ;;\n"
            "  upower) if [ \"${1:-}\" = -e ]; then printf '%s\\n' /org/freedesktop/UPower/devices/DisplayDevice; else printf '%s\\n' '  state:           charging'; fi ;;\n"
            "  powerprofilesctl) printf '%s\\n' '  balanced:' ;;\n"
            "  hyprctl) case ${1:-} in monitors) printf '%s\\n' '[{\"name\":\"DP-1\",\"focused\":true,\"scale\":1,\"x\":0,\"y\":0,\"width\":1920,\"height\":1080}]' ;; getoption) printf '%s\\n' '{\"int\":0}' ;; esac ;;\n"
            "  brightnessctl) printf '%s\\n' 'Device brightness, 50%' ;;\n"
            "  curl) printf '%s\\n' 'Probe|0C|0km/h' ;;\n"
            "  grim) last=; for arg do last=$arg; done; if [ \"$last\" != - ]; then : > \"$last\"; fi ;;\n"
            "  slurp) printf '%s\\n' '0,0 100x100' ;;\n"
            "  ip) if [ \"${1:-}\" = -j ] && [ \"${2:-}\" = route ]; then printf '%s\\n' '[{\"dev\":\"wlan0\",\"gateway\":\"192.0.2.254\",\"prefsrc\":\"192.0.2.1\"}]'; elif [ \"${1:-}\" = -j ] && [ \"${2:-}\" = addr ]; then printf '%s\\n' '[{\"addr_info\":[{\"family\":\"inet\",\"prefixlen\":24}]}]'; else printf '%s\\n' '1.1.1.1 via 192.0.2.254 dev wlan0 src 192.0.2.1'; fi ;;\n"
            "  iw) printf '%s\\n' 'Connected to 00:11:22:33:44:55 (on wlp0s20f3)' 'SSID: probe-network' 'freq: 2412' 'signal: -40.00 dBm' 'tx bitrate: 54.0 MBit/s' ;;\n"
            "  ping) printf '%s\\n' '64 bytes from 192.0.2.254: time=1.00 ms' ;;\n"
            "  busctl) printf '%s\\n' 'b false' ;;\n"
            "  date) printf '%s\\n' '2026-01-01_00-00-00' ;;\n"
            "  pgrep) exit 1 ;;\n"
            "  pkill) : ;;\n"
            "  notify-send|wl-copy|wtype|gtk-launch|update-desktop-database|xdg-open|gsettings|setsid|systemctl|rfkill|hyprpicker) : ;;\n"
            "  *) : ;;\n"
            "esac\n"
            ":\n",
            encoding="utf-8",
        )
        backend_path.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
        for backend in (
            "brightnessctl", "bluetoothctl", "curl", "grim", "gsettings", "gtk-launch", "hyprctl",
            "nmcli", "notify-send", "pactl", "powerprofilesctl", "pw-dump", "qrencode", "rfkill",
            "slurp", "systemctl", "update-desktop-database", "upower", "wl-copy", "wtype", "wpctl", "xdg-open", "hyprpicker",
            "ip", "iw", "ping", "busctl", "date", "pgrep", "pkill",
        ):
            target = probe_bin / backend
            if not target.exists():
                target.symlink_to(backend_path)
        trigger = CONSUMER_TRIGGERS.get(helper)
        probe_consumer_path = consumer_path
        if trigger:
            probe_consumer_path = probe_root / "consumer" / consumer_path.name
            probe_consumer_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(consumer_path.parent, probe_consumer_path.parent, dirs_exist_ok=True)
            probe_consumer_path.chmod(stat.S_IRUSR | stat.S_IWUSR)
            services_dir = probe_consumer_path.parent / "services"
            if services_dir.is_dir():
                services_dir.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
                (services_dir / "qmldir").write_text(
                    "AppLibrary 1.0 AppLibrary.qml\n"
                    "BarWidgetRegistry 1.0 BarWidgetRegistry.qml\n"
                    "PluginRegistry 1.0 PluginRegistry.qml\n",
                    encoding="utf-8",
                )
            text = probe_consumer_path.read_text(encoding="utf-8")
            source_patch = HEADLESS_SOURCE_PATCHES.get(helper)
            if source_patch is not None:
                old, new = source_patch
                if text.count(old) != 1:
                    fail(f"{helper} headless probe source-shape drifted")
                text = text.replace(old, new)
            text_patch = HEADLESS_TEXT_PATCHES.get(helper)
            if text_patch is not None:
                old, new = text_patch
                if text.count(old) != 1:
                    fail(f"{helper} headless probe source-shape drifted")
                text = text.replace(old, new)
            assignments = {
                "omarchy-audio-input-set-default": "    Pipewire.preferredDefaultAudioSource = node",
                "omarchy-audio-output-set-default": "    Pipewire.preferredDefaultAudioSink = node",
            }
            assignment = assignments.get(helper)
            if assignment is not None:
                if text.count(assignment) != 1:
                    fail(f"{helper} headless probe source-shape drifted")
                text = text.replace(assignment, "    void node")
            probe_consumer_path.write_text(text, encoding="utf-8")
        trigger_timer = (
            f"    Timer {{ interval: 500; repeat: true; running: true; onTriggered: "
            f"if (consumer.status === Loader.Ready) {{ Qt.callLater(function() {{ "
            f"if (consumer.item && typeof consumer.item.open === \"function\") consumer.item.open(); "
            f"{trigger}; }}); if (++harness.triggerCount >= 10) stop() }} }}\n"
            if trigger
            else ""
        )
        harness_path.write_text(
            "import QtQuick\n"
            "import Quickshell\n"
            "import Quickshell.Io\n"
            "ShellRoot {\n"
            "  Item {\n"
            "    id: harness\n"
            "    property int triggerCount: 0\n"
            "    function findPressable(item) {\n"
            "      if (item && typeof item.triggerPress === \"function\") return item\n"
            "      var children = item && item.children ? item.children : []\n"
            "      for (var i = 0; i < children.length; i++) {\n"
            "        var found = findPressable(children[i])\n"
            "        if (found) return found\n"
            "      }\n"
            "      return null\n"
            "    }\n"
            "    QtObject {\n"
            "      id: headlessBar\n"
            "      property color barForeground: \"white\"\n"
            "      property color foreground: \"white\"\n"
            "      property string fontFamily: \"Sans\"\n"
            "      property bool vertical: false\n"
            "      property int barSize: 24\n"
            "      function hideTooltip(item) {}\n"
            "      function run(command) {\n"
            "        var value = String(command || \"\")\n"
            "        if (value.indexOf(\"omarchy-weather-status\") !== -1) Quickshell.execDetached([\"omarchy-weather-status\"])\n"
            "        if (value.indexOf(\"omarchy-notification-send\") !== -1) Quickshell.execDetached([\"omarchy-notification-send\", \"probe\"])\n"
            "      }\n"
            "    }\n"
            f"    Loader {{ id: consumer; source: {json.dumps(str(probe_consumer_path))} }}\n"
            + trigger_timer
            + "    Timer { interval: 12000; running: true; onTriggered: Qt.quit() }\n"
            + "  }\n"
            + "}\n",
            encoding="utf-8",
        )
        probe_path.write_text(
            "#!/bin/sh\n"
            "set -eu\n"
            f"test -f {json.dumps(str(consumer_path))}\n"
            f"printf '%s\\t%s\\n' CONSUMER_PROBE {json.dumps(helper)}\n"
            f"export QML2_IMPORT_PATH={json.dumps(str(probe_root))}:{json.dumps(str(compatibility_bin))}\n"
            f"export OMARCHY_PATH={json.dumps(str(probe_root))}\n"
            f"export PATH={json.dumps(str(probe_bin))}:{json.dumps(str(compatibility_bin / 'bin'))}:$PATH\n"
            "export QT_QPA_PLATFORM=offscreen\n"
            f"marker_path=\"${{TMPDIR:-/tmp}}/omanixy-consumer-{helper}-$$\"\n"
            f"log_path=\"${{TMPDIR:-/tmp}}/omanixy-consumer-{helper}-$$.log\"\n"
            f"runtime_dir=\"${{TMPDIR:-/tmp}}/omanixy-runtime-{helper}-$$\"\n"
            f"home_dir=\"${{TMPDIR:-/tmp}}/omanixy-home-{helper}-$$\"\n"
            "mkdir -p \"$runtime_dir\" \"$home_dir/.cache\"\n"
            "chmod 700 \"$runtime_dir\"\n"
            "rm -f \"$marker_path\".*\n"
            "trap 'rm -f \"$marker_path\".* \"$log_path\"; rm -rf \"$runtime_dir\" \"$home_dir\"' EXIT\n"
            "export OMANIXY_CONSUMER_MARKER=\"$marker_path\"\n"
            f"export OMANIXY_PROBE_BACKEND_PATH={json.dumps(str(probe_bin))}\n"
            "unset COMPAT_ADAPTER_NAME\n"
            "export XDG_RUNTIME_DIR=\"$runtime_dir\"\n"
            "export XDG_CONFIG_HOME=\"$home_dir/.config\"\n"
            "export XDG_STATE_HOME=\"$home_dir/.local/state\"\n"
            "export XDG_DATA_HOME=\"$home_dir/.local/share\"\n"
            "export XDG_CACHE_HOME=\"$home_dir/.cache\"\n"
            "export HOME=\"$home_dir\"\n"
            "if timeout 14s "
            f"{json.dumps(str(quickshell))} -n -p {json.dumps(str(harness_path))} \"$@\" >\"$log_path\" 2>&1; then\n"
            "  probe_status=0\n"
            "else\n"
            "  probe_status=$?\n"
            "fi\n"
            f"if test \"$probe_status\" -eq 0 && grep -Fxq {json.dumps(helper)} \"$marker_path.{helper}\" 2>/dev/null; then\n"
            f"  printf 'CONSUMER_REACHED\\t%s\\n' {json.dumps(helper)}\n"
            "else\n"
            f"  printf 'dispatcher marker identity: expected {helper}, got:' >&2\n"
            f"  cat \"$marker_path.{helper}\" >&2 2>/dev/null || :\n"
            "  cat \"$log_path\" >&2\n"
            "  if test \"$probe_status\" -eq 0; then exit 1; else exit \"$probe_status\"; fi\n"
            "fi\n",
            encoding="utf-8",
        )
        probe_path.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
        if not helper_path.is_symlink() or not dispatcher_path.is_symlink():
            fail(f"{helper} does not use the packaged compatibility dispatcher")
        surface[helper] = {
            "consumer": consumer,
            "consumerSourceSha256": hashlib.sha256(source).hexdigest(),
            "consumerSources": consumer_sources,
            "helperTarget": str(helper_path.resolve()),
            "helperTargetSha256": hashlib.sha256(helper_path.resolve().read_bytes()).hexdigest(),
            "dispatcherTarget": str(dispatcher_path.resolve()),
            "dispatcherTargetSha256": hashlib.sha256(dispatcher_path.resolve().read_bytes()).hexdigest(),
            "consumerProbe": {
                "executable": f"bin/{probe_name}",
                "helper": helper,
                "invocation": "generated-post-patch-consumer",
                "marker": "dispatcher-command-identity-success-only-v1",
            },
        }
    (compatibility_bin / "runtime-surface.json").write_text(
        json.dumps(surface, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
