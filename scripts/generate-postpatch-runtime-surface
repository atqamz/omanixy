#!/usr/bin/env python3
"""Generate post-patch consumer identity and executable probes."""

from __future__ import annotations

import hashlib
import json
import shutil
import stat
import sys
from pathlib import Path


def fail(message: str) -> None:
    print(f"post-patch runtime surface: {message}", file=sys.stderr)
    raise SystemExit(1)


HEADLESS_KEYBOARD_PANEL = """import QtQuick

Item {
  id: root

  property Item anchorItem: null
  property var owner: null
  property var bar: null
  property int margin: 0
  property int padding: 0
  property int contentWidth: 0
  property int contentHeight: 0
  property bool centerOnBar: false
  property bool open: false
  property int gap: 0
  property bool popoutSwitching: false
  property bool popoutSwitchClosing: false
  property Item focusTarget: null
  default property alias contentItem: content.children

  function fittedContentWidth(value) { return value }
  function fittedContentHeight(value) { return value }

  Item {
    id: content
    anchors.fill: parent
  }
}
"""


CONSUMER_TRIGGERS = {
    "omarchy-audio-input-set-default": "consumer.item.setDefaultSource({ id: 1, name: \"probe-source\" })",
    "omarchy-audio-output-set-default": "consumer.item.setDefaultSink({ id: 1, name: \"probe-sink\" })",
    "omarchy-audio-output-sink": "consumer.item.open()",
    "omarchy-audio-sink-availability": "consumer.item.open()",
    "omarchy-battery-status": "consumer.item.bar = headlessBar; consumer.item.open()",
    "omarchy-system-stats": "consumer.item.bar = headlessBar; consumer.item.open()",
    "omarchy-bluetooth-device": "consumer.item.runDeviceAction({ address: \"00:11:22:33:44:55\" }, \"connect\", \"connecting\")",
    "omarchy-bluetooth-power": "consumer.item.toggleBluetooth()",
    "omarchy-brightness-display": "consumer.item.setBrightness(50)",
    "omarchy-capture-screenshot": "consumer.item.runAction(\"omarchy-capture-screenshot\")",
    "omarchy-clipboard-open": "consumer.item.openSelected({ historyIndex: 0 })",
    "omarchy-clipboard-paste-file": "consumer.item.applySelected({ entryType: \"image\", mime: \"image/png\", path: \"/tmp/probe.png\", historyIndex: 0 })",
    "omarchy-clipboard-paste-text": "consumer.item.applySelected({ entryType: \"text\", fullText: \"probe\", historyIndex: 0 })",
    "omarchy-display-text-size": "consumer.item.setTextSize(12)",
    "omarchy-hyprland-monitor-scaling": "consumer.item.setScale(1)",
    "omarchy-menu-emoji-insert": "consumer.item.applySelected(\"😀\")",
    "omarchy-monitor-state": "consumer.item.refresh()",
    "omarchy-network-password": "consumer.item.togglePassword()",
    "omarchy-network-qr": "consumer.item.generate(\"wlan0\")",
    "omarchy-network-status": "consumer.item.open()",
    "omarchy-network-band": "consumer.item.open()",
    "omarchy-dns": "consumer.item.open()",
    "omarchy-notification-send": "consumer.item.bar = headlessBar; var target = harness.findPressable(consumer.item); if (target) target.triggerPress(Qt.RightButton)",
    "omarchy-powerprofiles-list": "consumer.item.items = { probe: { provider: \"power-profiles\" } }; consumer.item.startProviderForMenu(\"probe\")",
    "omarchy-powerprofiles-set": "consumer.item.applySelected(\"probe\", consumer.item.providers[\"power-profiles\"].actionFor(\"balanced\"))",
    "omarchy-remove-launcher-entry": "consumer.item.userOwnedEntryIds = { \"org.example.User\": true }; consumer.item.remove(\"org.example.User.desktop\", \"Probe\")",
    "omarchy-weather-location": "consumer.item.bar = headlessBar; consumer.item.persistLocation(\"Probe\", 1, 2)",
    "omarchy-weather-status": "consumer.item.bar = headlessBar; var target = harness.findPressable(consumer.item); if (target) target.triggerPress(Qt.RightButton)",
}


