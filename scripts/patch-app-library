#!/usr/bin/env python3

from pathlib import Path
import sys


def block(lines: list[str]) -> str:
    return "\n".join(lines) + "\n"


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{label}: expected one pinned block, found {count}")
    return text.replace(old, new, 1)


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} APP_LIBRARY_QML", file=sys.stderr)
        return 2
    path = Path(sys.argv[1])
    text = path.read_text()
    text = replace_once(
        text,
        'import "AppSearch.js" as AppSearch\n',
        'import "AppSearch.js" as AppSearch\nimport "AppLibrarySupport.js" as AppLibrarySupport\n',
        "AppLibrary import",
    )
    text = replace_once(
        text,
        '  property var desktopHiddenEntryIds: ({})\n',
        '  property var desktopHiddenEntryIds: ({})\n  property var userOwnedEntryIds: ({})\n',
        "AppLibrary ownership property",
    )
    text = replace_once(
        text,
        block([
            '  property int launchToplevelCount: 0',
            '  property var launchActiveToplevel: null',
        ]),
        block([
            '  property var launchExpectedEntry: null',
            '  property var launchTargetToplevel: null',
            '  property var launchInitialMatches: []',
            '  property var launchInitialActiveToplevel: null',
        ]),
        "AppLibrary launch state",
    )
    text = replace_once(
        text,
        block([
            '  function launch(desktopId, name) {',
            '    var id = String(desktopId || "")',
            '    if (!id) return',
            '    root.beginLaunchFeedback(name)',
        ]),
        block([
            '  function launch(desktopId, name) {',
            '    var id = AppLibrarySupport.normalizeDesktopId(desktopId)',
            '    if (!AppLibrarySupport.isValidDesktopId(id)) return',
            '    var entry = DesktopEntries.byId(id)',
            '    if (!entry) return',
            '    id = AppLibrarySupport.normalizeDesktopId(entry.id)',
            '    if (!AppLibrarySupport.isValidDesktopId(id)) return',
            '    var matches = AppLibrarySupport.matchingToplevels(entry, ToplevelManager.toplevels.values || [])',
            '    var toplevel = matches.length === 1 ? matches[0] : null',
            '    if (toplevel) {',
            '      root.beginLaunchFeedback(name, entry, toplevel, matches)',
            '      toplevel.activate()',
            '      root.maybeFinishLaunchFeedback()',
            '      return',
            '    }',
            '    root.beginLaunchFeedback(name, entry, null, matches)',
        ]),
        "AppLibrary launch function",
    )
    remove_old = block([
        '  function remove(desktopId, name) {',
        '    var id = String(desktopId || "")',
        '    if (!id) return',
        '    Util.execDetached(Util.shellQuote(root.omarchyPath + "/bin/omarchy-remove-launcher-entry") + " " + Util.shellQuote(id) + " " + Util.shellQuote(String(name || id)))',
        '  }',
    ])
    remove_new = block([
        '  function canRemove(desktopId) {',
        '    return AppLibrarySupport.canRemove(desktopId, root.userOwnedEntryIds)',
        '  }',
        '',
        '  function remove(desktopId, name) {',
        '    var id = String(desktopId || "")',
        '    if (!root.canRemove(id)) return',
        '    removeProcess.command = [',
        '      "bash",',
        '      "-c",',
        '      Util.shellQuote(root.omarchyPath + "/bin/omarchy-remove-launcher-entry") + " " + Util.shellQuote(id) + " " + Util.shellQuote(String(name || id))',
        '    ]',
        '    removeProcess.running = true',
        '  }',
    ])
    text = replace_once(text, remove_old, remove_new, "AppLibrary removal function")
    normalize_old = block([
        '  function normalizeDesktopId(id) {',
        '    var value = String(id || "").trim()',
        '    if (value.slice(-8) === ".desktop") value = value.slice(0, -8)',
        '    return value',
        '  }',
    ])
    normalize_new = block([
        '  function normalizeDesktopId(id) {',
        '    return AppLibrarySupport.normalizeDesktopId(id)',
        '  }',
        '',
        '  function userApplicationsDirectory() {',
        '    var dataHome = Quickshell.env("XDG_DATA_HOME")',
        '    if (!dataHome) dataHome = Quickshell.env("HOME") + "/.local/share"',
        '    return dataHome + "/applications"',
        '  }',
        '',
        '  function userOwnedEntryScanCommand() {',
        '    var directory = root.userApplicationsDirectory()',
        '    var quoted = Util.shellQuote(directory)',
        '    return "if [[ -d " + quoted + " && ! -L " + quoted + " ]]; then find -P " + quoted + " -maxdepth 1 -type f -name \'*.desktop\' -printf \'%f\\n\'; fi"',
        '  }',
        '',
        '  function loadUserOwnedEntries(rawText) {',
        '    var next = ({})',
        '    var lines = String(rawText || "").split(/\\n/)',
        '    for (var i = 0; i < lines.length; i++) {',
        '      var id = AppLibrarySupport.desktopFileId(lines[i])',
        '      if (AppLibrarySupport.isValidDesktopId(id)) next[id] = true',
        '    }',
        '    root.userOwnedEntryIds = next',
        '  }',
        '',
        '  function refreshUserOwnedEntries() {',
        '    if (!userOwnedEntryScan.running) userOwnedEntryScan.running = true',
        '  }',
    ])
    text = replace_once(text, normalize_old, normalize_new, "AppLibrary ownership functions")
    feedback_old = block([
        '  function beginLaunchFeedback(name) {',
        '    root.launchSerial++',
        '    root.launchToplevelCount = root.toplevelCount()',
        '    root.launchActiveToplevel = ToplevelManager.activeToplevel',
        '    root.launchOsdMessage = "Launching " + String(name || "application") + "…"',
        '    launchDelay.restart()',
        '    launchTimeout.restart()',
        '  }',
        '',
        '  function closeLaunchFeedback(serial) {',
        '    if (serial !== root.launchSerial) return',
        '    launchDelay.stop()',
        '    launchTimeout.stop()',
        '    if (root.launchOsdOpen) {',
        '      Quickshell.execDetached(["omarchy-shell", "osd", "close"])',
        '      root.launchOsdOpen = false',
        '    }',
        '  }',
        '',
        '  function maybeFinishLaunchFeedback() {',
        '    if (!launchDelay.running && !launchTimeout.running && !root.launchOsdOpen) return',
        '    if (root.toplevelCount() <= root.launchToplevelCount && ToplevelManager.activeToplevel === root.launchActiveToplevel) return',
        '    root.closeLaunchFeedback(root.launchSerial)',
        '  }',
    ])
    feedback_new = block([
        '  function beginLaunchFeedback(name, entry, target, initialMatches) {',
        '    root.launchSerial++',
        '    root.launchExpectedEntry = entry',
        '    root.launchTargetToplevel = target',
        '    root.launchInitialMatches = initialMatches || []',
        '    root.launchInitialActiveToplevel = ToplevelManager.activeToplevel',
        '    root.launchOsdMessage = (target ? "Activating " : "Launching ") + String(name || "application") + "…"',
        '    launchDelay.restart()',
        '    launchTimeout.restart()',
        '  }',
        '',
        '  function closeLaunchFeedback(serial) {',
        '    if (serial !== root.launchSerial) return',
        '    launchDelay.stop()',
        '    launchTimeout.stop()',
        '    root.launchExpectedEntry = null',
        '    root.launchTargetToplevel = null',
        '    root.launchInitialMatches = []',
        '    root.launchInitialActiveToplevel = null',
        '    if (root.launchOsdOpen) {',
        '      Quickshell.execDetached(["omarchy-shell", "osd", "close"])',
        '      root.launchOsdOpen = false',
        '    }',
        '  }',
        '',
        '  function launchSucceeded() {',
        '    var active = ToplevelManager.activeToplevel',
        '    if (root.launchTargetToplevel)',
        '      return AppLibrarySupport.activationSucceeded(root.launchTargetToplevel, active)',
        '    if (!root.launchExpectedEntry) return false',
        '    return AppLibrarySupport.coldLaunchSucceeded(',
        '      root.launchExpectedEntry,',
        '      ToplevelManager.toplevels.values || [],',
        '      root.launchInitialMatches,',
        '      root.launchInitialActiveToplevel,',
        '      active',
        '    )',
        '  }',
        '',
        '  function maybeFinishLaunchFeedback() {',
        '    if (!launchDelay.running && !launchTimeout.running && !root.launchOsdOpen) return',
        '    if (!root.launchSucceeded()) return',
        '    root.closeLaunchFeedback(root.launchSerial)',
        '  }',
    ])
    text = replace_once(text, feedback_old, feedback_new, "AppLibrary launch feedback")
    output_old = block([
        '  QtObject {',
        '    id: hiddenEntryOutput',
        '    property string text: ""',
        '  }',
    ])
    output_new = block([
        '  QtObject {',
        '    id: hiddenEntryOutput',
        '    property string text: ""',
        '  }',
        '',
        '  QtObject {',
        '    id: userOwnedEntryOutput',
        '    property string text: ""',
        '  }',
    ])
    text = replace_once(text, output_old, output_new, "AppLibrary ownership output")
    process_old = block([
        '  Process {',
        '    id: hiddenEntryScan',
    ])
    process_new = block([
        '  Process {',
        '    id: userOwnedEntryScan',
        '    command: ["bash", "-c", root.userOwnedEntryScanCommand()]',
        '    stdout: SplitParser { onRead: function(line) { userOwnedEntryOutput.text += line + "\\n" } }',
        '    onStarted: userOwnedEntryOutput.text = ""',
        '    onExited: root.loadUserOwnedEntries(userOwnedEntryOutput.text)',
        '  }',
        '',
        '  Process {',
        '    id: removeProcess',
        '    onExited: root.refreshUserOwnedEntries()',
        '  }',
        '',
        '  Process {',
        '    id: hiddenEntryScan',
    ])
    text = replace_once(text, process_old, process_new, "AppLibrary ownership processes")
    text = replace_once(
        text,
        '      if (root.toplevelCount() > root.launchToplevelCount || ToplevelManager.activeToplevel !== root.launchActiveToplevel) return\n',
        '      if (root.launchSucceeded()) { root.closeLaunchFeedback(root.launchSerial); return }\n',
        "AppLibrary launch delay",
    )
    refresh_old = block([
        '    function onValuesChanged() {',
        '      hiddenEntryScan.running = true',
        '      iconIndexDebounce.restart()',
        '      root.appsChanged()',
        '    }',
    ])
    refresh_new = block([
        '    function onValuesChanged() {',
        '      hiddenEntryScan.running = true',
        '      root.refreshUserOwnedEntries()',
        '      iconIndexDebounce.restart()',
        '      root.appsChanged()',
        '    }',
    ])
    text = replace_once(text, refresh_old, refresh_new, "AppLibrary refresh connection")
    startup_old = block([
        '  Component.onCompleted: {',
        '    hiddenEntryScan.running = true',
        '    iconIndexScan.running = true',
        '  }',
    ])
    startup_new = block([
        '  Component.onCompleted: {',
        '    hiddenEntryScan.running = true',
        '    userOwnedEntryScan.running = true',
        '    iconIndexScan.running = true',
        '  }',
    ])
    text = replace_once(text, startup_old, startup_new, "AppLibrary startup scans")
    path.write_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
