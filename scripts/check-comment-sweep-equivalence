#!/usr/bin/env python3
import ast
import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import tomllib
from pathlib import Path

import yaml


DOCSTRING_OWNERS = (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)


def _leading_string_expr(node):
    if not isinstance(node, DOCSTRING_OWNERS):
        return None
    body = getattr(node, "body", None)
    if not body:
        return None
    first = body[0]
    if (
        isinstance(first, ast.Expr)
        and isinstance(first.value, ast.Constant)
        and isinstance(first.value.value, str)
    ):
        return first
    return None


def _strip_docstrings(tree):
    for node in ast.walk(tree):
        body = getattr(node, "body", None)
        doc_node = _leading_string_expr(node) if isinstance(body, list) else None
        if doc_node is not None:
            node.body = node.body[1:]
            if not node.body and isinstance(node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
                node.body.append(ast.Pass())
    return tree


def compare_python(path, before_text, after_text):
    before_tree = _strip_docstrings(ast.parse(before_text, filename=str(path)))
    after_tree = _strip_docstrings(ast.parse(after_text, filename=str(path)))
    return ast.dump(before_tree, annotate_fields=True, include_attributes=False) == \
        ast.dump(after_tree, annotate_fields=True, include_attributes=False)


def compare_nix(path, before_text, after_text):
    return _nix_parse(_strip_nix_narrative_comments(path, before_text)) == _nix_parse(after_text)


def _nix_parse(text):
    result = subprocess.run(
        ["nix-instantiate", "--parse", "-"],
        input=text, capture_output=True, text=True, encoding="utf-8", check=True,
    )
    return result.stdout


_CHECK_SOURCE_COMMENTS_PATH = Path(__file__).resolve().parent / "check-source-comments"


def _load_check_source_comments():
    loader = importlib.machinery.SourceFileLoader("check_source_comments", str(_CHECK_SOURCE_COMMENTS_PATH))
    spec = importlib.util.spec_from_file_location(
        "check_source_comments", _CHECK_SOURCE_COMMENTS_PATH, loader=loader
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


_check_source_comments = _load_check_source_comments()
_ShellLexer = _check_source_comments._ShellLexer
_scan_nix = _check_source_comments.scan_nix
_scan_js_region = _check_source_comments._scan_js_region
_scan_jsonc = _check_source_comments.scan_jsonc


def _line_starts(text):
    starts = [0]
    for i, char in enumerate(text):
        if char == "\n":
            starts.append(i + 1)
    return starts


def _nix_comment_spans(path, text):
    starts = _line_starts(text)
    spans = []
    for violation in _scan_nix(path, text):
        if violation.kind != "narrative-comment":
            continue
        line_start = starts[violation.line - 1]
        if "\n" not in violation.text:
            line_end = text.find("\n", line_start)
            if line_end == -1:
                line_end = len(text)
            start = text.rfind(violation.text, line_start, line_end)
            if start == -1:
                raise ValueError(f"{path}: cannot locate Nix comment at line {violation.line}")
        else:
            expected = line_start + violation.col
            if not text.startswith(violation.text, expected):
                raise ValueError(f"{path}: cannot locate Nix comment at line {violation.line}")
            start = expected
        spans.append((start, start + len(violation.text)))
    return spans


def _comment_span_offsets(text, comment_tokens):
    line_starts = _line_starts(text)
    spans = []
    for line, col, comment_text in comment_tokens:
        start = line_starts[line - 1] + col
        spans.append((start, start + len(comment_text)))
    return spans


def _strip_spans_and_normalize_whitespace(text, spans):
    expanded_spans = []
    for start, end in spans:
        line_start = text.rfind("\n", 0, start) + 1
        line_end = text.find("\n", end)
        if line_end == -1:
            line_end = len(text)
        if text[line_start:start].strip(" \t") == "" and text[end:line_end].strip(" \t") == "":
            if _has_line_continuation(text, line_start):
                expanded_spans.append((start, end))
            else:
                end_of_line = line_end + 1 if line_end < len(text) else line_end
                expanded_spans.append((line_start, end_of_line))
        else:
            expanded_spans.append((start, end))
    parts = []
    cursor = 0
    for start, end in sorted(expanded_spans):
        parts.append(text[cursor:start].rstrip(" \t"))
        cursor = end
    parts.append(text[cursor:])
    return "".join(parts)


def _has_line_continuation(text, line_start):
    if line_start == 0:
        return False
    previous_line_start = text.rfind("\n", 0, line_start - 1) + 1
    previous_line = text[previous_line_start:line_start].rstrip("\n")
    backslashes = 0
    for char in reversed(previous_line):
        if char != "\\":
            break
        backslashes += 1
    return backslashes % 2 == 1


def _strip_nix_narrative_comments(path, text):
    return _strip_spans_and_normalize_whitespace(text, _nix_comment_spans(path, text))


def compare_shell(path, before_text, after_text):
    return _shell_noncomment_tokens(path, before_text) == _shell_noncomment_tokens(path, after_text)


def _shell_noncomment_tokens(path, text):
    return _strip_spans_and_normalize_whitespace(text, _shell_comment_spans(path, text))


def _shell_comment_spans(path, text):
    return _comment_span_offsets(text, _ShellLexer(path, text).run())


def compare_js(path, before_text, after_text):
    return _js_noncomment_tokens(path, before_text) == _js_noncomment_tokens(path, after_text)


def _js_noncomment_tokens(path, text):
    return _strip_spans_and_normalize_whitespace(text, _js_comment_spans(path, text))


def _js_comment_spans(path, text):
    raw_spans = []
    _scan_js_region(path, text, 0, len(text), raw_spans, in_interpolation=False)
    return _comment_span_offsets(text, raw_spans)


def compare_yaml(path, before_text, after_text):
    return yaml.safe_load(before_text) == yaml.safe_load(after_text)


def _jsonc_comment_spans(path, text):
    starts = _line_starts(text)
    spans = []
    for violation in _scan_jsonc(path, text):
        if violation.kind != "narrative-comment":
            continue
        start = starts[violation.line - 1] + violation.col
        if not text.startswith(violation.text, start):
            raise ValueError(f"{path}: cannot locate JSONC comment at line {violation.line}")
        spans.append((start, start + len(violation.text)))
    return spans


def _jsonc_data(path, text):
    without_comments = _strip_spans_and_normalize_whitespace(
        text, _jsonc_comment_spans(path, text)
    )
    return json.loads(without_comments)


def compare_jsonc(path, before_text, after_text):
    return _jsonc_data(path, before_text) == _jsonc_data(path, after_text)


def compare_toml(path, before_text, after_text):
    return tomllib.loads(before_text) == tomllib.loads(after_text)


COMPARATORS = {
    "python": compare_python,
    "nix": compare_nix,
    "shell": compare_shell,
    "js": compare_js,
    "qml": compare_js,
    "yaml": compare_yaml,
    "jsonc": compare_jsonc,
    "toml": compare_toml,
}


STRUCTURED_DATA_CORRECTIONS = {
    "upstream/porting-matrix.yaml": {
        "path": ("items", 12, "notes", 1),
        "before": "No third-party endpoint, token, background worker, or fabricated sample is retained in the issue",
        "after": "No third-party endpoint, token, background worker, or fabricated sample is retained in the issue #3 runtime.",
    },
}
SWEEP_POLICY_TOOL_ADDITIONS = {
    "scripts/check-comment-sweep-equivalence",
    "test/lib/comment-sweep-equivalence-selftest.py",
}
SWEEP_POLICY_TOOL_CHANGES = {
    "flake.nix",
    "scripts/check-source-comments",
    "test/lib/source-comment-policy-selftest.py",
}


def _value_at_path(value, path):
    for part in path:
        value = value[part]
    return value


def _structured_data_correction(relative_path, before_text, after_text):
    correction = STRUCTURED_DATA_CORRECTIONS.get(str(relative_path))
    if correction is None:
        return None
    before = yaml.safe_load(before_text)
    after = yaml.safe_load(after_text)
    path = correction["path"]
    if _value_at_path(before, path) != correction["before"]:
        return None
    if _value_at_path(after, path) != correction["after"]:
        return None
    before_without_value = yaml.safe_load(before_text)
    after_without_value = yaml.safe_load(after_text)
    before_cursor = before_without_value
    after_cursor = after_without_value
    for part in path[:-1]:
        before_cursor = before_cursor[part]
        after_cursor = after_cursor[part]
    before_cursor[path[-1]] = None
    after_cursor[path[-1]] = None
    if before_without_value != after_without_value:
        return None
    return {
        "path": str(relative_path),
        "yamlPath": [*path],
        "beforeParsedValue": correction["before"],
        "afterParsedValue": correction["after"],
        "classification": "intentional-structured-data-correction",
    }


def compare_tree(
    before_root,
    after_root,
    allow_structured_data_corrections=False,
    allow_sweep_policy_tool_additions=False,
    allow_sweep_policy_tool_changes=False,
):
    before_root = Path(before_root).resolve()
    after_root = Path(after_root).resolve()
    source_trees = []
    for root in (before_root, after_root):
        sources = {}
        for path in _check_source_comments.discover_source_files(root):
            language = _check_source_comments.classify_language(path, root)
            if language == "unsupported":
                raise ValueError(f"unsupported maintained source language: {path.relative_to(root)}")
            if language is not None:
                sources[path.relative_to(root)] = (path, language)
        source_trees.append(sources)
    before_sources, after_sources = source_trees
    if set(before_sources) != set(after_sources):
        missing = sorted(set(before_sources) - set(after_sources))
        added = sorted(set(after_sources) - set(before_sources))
        allowed_additions = {
            Path(path)
            for path in SWEEP_POLICY_TOOL_ADDITIONS
        } if allow_sweep_policy_tool_additions else set()
        unexpected_additions = sorted(set(added) - allowed_additions)
        if missing or unexpected_additions:
            raise ValueError(
                f"source tree changed: missing={missing}, added={added}, "
                f"unexpected additions={unexpected_additions}"
            )
    allowed_changes = {
        Path(path)
        for path in SWEEP_POLICY_TOOL_CHANGES
    } if allow_sweep_policy_tool_changes else set()
    entries = []
    for relative_path in sorted(before_sources):
        before_path, before_language = before_sources[relative_path]
        after_path, after_language = after_sources[relative_path]
        if before_language != after_language:
            raise ValueError(f"source language changed: {relative_path}")
        equivalent = COMPARATORS[before_language](
            relative_path,
            before_path.read_text(encoding="utf-8", errors="surrogateescape"),
            after_path.read_text(encoding="utf-8", errors="surrogateescape"),
        )
        entry = {"path": str(relative_path), "language": before_language, "equivalent": equivalent}
        if not equivalent:
            correction = None
            if allow_structured_data_corrections and before_language == "yaml":
                correction = _structured_data_correction(
                    relative_path,
                    before_path.read_text(encoding="utf-8", errors="surrogateescape"),
                    after_path.read_text(encoding="utf-8", errors="surrogateescape"),
                )
            if correction is None:
                if allow_sweep_policy_tool_changes and relative_path in allowed_changes:
                    entry["policyToolChange"] = True
                else:
                    raise ValueError(f"executable semantics changed: {relative_path}")
            else:
                entry["structuredDataCorrection"] = correction
        entries.append(entry)
    return entries


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("before_root", type=Path)
    parser.add_argument("after_root", type=Path)
    parser.add_argument("--report", type=Path, required=True)
    parser.add_argument("--allow-structured-data-corrections", action="store_true")
    parser.add_argument("--allow-sweep-policy-tool-additions", action="store_true")
    parser.add_argument("--allow-sweep-policy-tool-changes", action="store_true")
    args = parser.parse_args(argv)
    entries = compare_tree(
        args.before_root,
        args.after_root,
        allow_structured_data_corrections=args.allow_structured_data_corrections,
        allow_sweep_policy_tool_additions=args.allow_sweep_policy_tool_additions,
        allow_sweep_policy_tool_changes=args.allow_sweep_policy_tool_changes,
    )
    corrections = [entry["structuredDataCorrection"] for entry in entries if "structuredDataCorrection" in entry]
    policy_tool_changes = [entry["path"] for entry in entries if entry.get("policyToolChange")]
    before_paths = {
        path.relative_to(Path(args.before_root).resolve())
        for path in _check_source_comments.discover_source_files(args.before_root)
        if _check_source_comments.classify_language(path, Path(args.before_root).resolve()) is not None
    }
    after_paths = {
        path.relative_to(Path(args.after_root).resolve())
        for path in _check_source_comments.discover_source_files(args.after_root)
        if _check_source_comments.classify_language(path, Path(args.after_root).resolve()) is not None
    }
    policy_tool_additions = sorted(str(path) for path in after_paths - before_paths)
    report = {
        "before": str(args.before_root.resolve()),
        "after": str(args.after_root.resolve()),
        "files": entries,
        "equivalentFiles": sum(entry["equivalent"] for entry in entries),
        "structuredDataCorrections": corrections,
        "policyToolAdditions": policy_tool_additions,
        "policyToolChanges": policy_tool_changes,
        "cleanupOwnedFiles": len(entries) - len(policy_tool_changes),
        "cleanupOwnedEquivalentFiles": sum(
            entry["equivalent"]
            for entry in entries
            if not entry.get("policyToolChange")
        ),
        "equivalent": not corrections and all(entry["equivalent"] for entry in entries),
    }
    args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(
        "comment-sweep-equivalence: "
        f"{report['cleanupOwnedEquivalentFiles']} cleanup-owned source files equivalent; "
        f"{len(corrections)} explicit structured-data corrections; "
        f"{len(policy_tool_changes)} policy-tool changes; "
        f"{len(policy_tool_additions)} policy-tool additions"
    )


if __name__ == "__main__":
    main()
