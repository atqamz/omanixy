#!/usr/bin/env python3
"""Check post-patch source reachability against presentation and capability metadata."""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

from source_discovery import shell_executables, source_executables


HELPER_PATTERN = re.compile(r"\bomarchy-[a-z0-9-]+\b")
HELPER_INVOCATION_PATTERN = re.compile(
    r"(?:\.run\s*\(|\.exec(?:Detached)?\s*\(|\bcommand\s*[:=]|\.command\s*=|"
    r"\b(?:action|script)\s*[:=]|shellQuote\s*\(|\bexec\s+|\bsource\s+)"
)
SOURCE_SUFFIXES = {".qml", ".js", ".json", ".jsonc", ".sh", ".bash"}
MENU_FIELDS = ("action", "when", "checked")


def fail(message: str) -> None:
    print(f"feature consumer closure: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")
    if not isinstance(value, dict):
        fail(f"{path} is not an object")
    return value


def root_entry_for(path: str, roots: list[dict]) -> dict | None:
    matches = [
        entry
        for entry in roots
        if path == entry["prefix"].rstrip("/") or path.startswith(entry["prefix"])
    ]
    if len(matches) != 1:
        return None
    return matches[0]


def feature_for(path: str, roots: list[dict]) -> str | None:
    entry = root_entry_for(path, roots)
    return entry["feature"] if entry else None


def active_lines(text: str) -> list[str]:
    lines: list[str] = []
    block_comment = False
    for line in text.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        active = []
        index = 0
        while index < len(line):
            if block_comment:
                end = line.find("*/", index)
                if end < 0:
                    break
                block_comment = False
                index = end + 2
                continue
            start = line.find("/*", index)
            if start < 0:
                active.append(line[index:])
                break
            active.append(line[index:start])
            end = line.find("*/", start + 2)
            if end < 0:
                block_comment = True
                break
            index = end + 2
        if active:
            lines.append("".join(active))
    return lines


def noise_for(path: str, helper: str, lines: list[str], scanner_noise: list[dict]) -> bool:
    entries = [
        entry
        for entry in scanner_noise
        if entry["path"] == path and entry["helper"] == helper
    ]
    if not entries:
        return False
    if len(entries) != 1:
        fail(f"duplicate scanner noise evidence for {path}: {helper}")
    exact_line = entries[0]["exactLine"]
    matching_lines = [line for line in lines if helper in line]
    if matching_lines == [exact_line]:
        return True
    fail(f"scanner noise evidence drifted for {path}: {helper}")


def parse_jsonc(text: str) -> object:
    stripped = re.sub(r"^\s*//[^\n]*(?:\n|$)", "", text, flags=re.MULTILINE)
    stripped = re.sub(r",(\s*[}\]])", r"\1", stripped)
    try:
        return json.loads(stripped)
    except json.JSONDecodeError as error:
        fail(f"supported JSON source is invalid: {error}")


def json_executables(path: str, text: str) -> list[dict[str, object]]:
    data = parse_jsonc(text)
    entries = data.get("items", data) if isinstance(data, dict) else {}
    if not isinstance(entries, dict):
        return []
    references: list[dict[str, object]] = []
    for item_id, item in entries.items():
        if not isinstance(item, dict):
            continue
        for field in MENU_FIELDS:
            value = item.get(field)
            if not isinstance(value, str) or not value:
                continue
            for name in shell_executables(value):
                if name.startswith("omarchy-"):
                    continue
                references.append(
                    {
                        "name": name,
                        "line": 1,
                        "invocation": f"menu.{field}",
                        "id": item_id,
                        "field": field,
                    }
                )
    return references


def json_helpers(text: str) -> list[dict[str, object]]:
    data = parse_jsonc(text)
    entries = data.get("items", data) if isinstance(data, dict) else {}
    if not isinstance(entries, dict):
        return []
    references: list[dict[str, object]] = []
    for item_id, item in entries.items():
        if not isinstance(item, dict):
            continue
        for field in MENU_FIELDS:
            value = item.get(field)
            if not isinstance(value, str) or not value:
                continue
            for match in HELPER_PATTERN.finditer(value):
                references.append(
                    {
                        "name": match.group(0),
                        "line": 1,
                        "invocation": f"menu.{field}",
                        "id": item_id,
                        "field": field,
                    }
                )
    return references


def consumer_feature_for(
    path: str,
    kind: str,
    name: str,
    default: str,
    reference: dict[str, object],
    overrides: list[dict],
    occurrence_count: int,
    mixed: bool,
) -> str:
    candidates = [
        entry
        for entry in overrides
        if entry.get("path") == path and entry.get(kind) == name
    ]
    precise = []
    generic = []
    for entry in candidates:
        identity_fields = [field for field in ("id", "field", "line", "shape") if field in entry]
        if not identity_fields:
            generic.append(entry)
            continue
        if all(entry[field] == reference.get(field) for field in identity_fields):
            precise.append(entry)
    if len(precise) > 1 or len(generic) > 1 or (precise and generic):
        fail(f"duplicate consumer feature override for {path}: {kind}={name}")
    if precise:
        return precise[0]["feature"]
    if generic:
        if occurrence_count > 1:
            fail(
                f"consumer feature override for {path}: {kind}={name} "
                "is not occurrence-specific"
            )
        return generic[0]["feature"]
    if mixed and occurrence_count > 1:
        fail(
            f"mixed-source references for {path}: {kind}={name} "
            "must have occurrence-specific feature identities"
        )
    return default


def validate_source_inventory(root: Path, roots: list[dict]) -> list[str]:
    source_paths = sorted(
        str(path.relative_to(root))
        for path in root.rglob("*")
        if path.is_file() and path.suffix in SOURCE_SUFFIXES
    )
    for entry in roots:
        source = root / entry["prefix"].rstrip("/")
        if not source.exists():
            fail(f"declared feature root is missing: {entry['prefix']}")
    for relative in source_paths:
        if feature_for(relative, roots) is None:
            fail(f"shipped supported source has no feature identity: {relative}")
    return source_paths


def resolve_capabilities(
    selected_features: list[str],
    feature_capabilities: dict[str, list[str]],
    capability_dependencies: dict[str, list[str]],
) -> set[str]:
    result: set[str] = set()
    active: set[str] = set()

    def visit(capability: str) -> None:
        if capability in result:
            return
        if capability in active:
            fail(f"cyclic capability dependency at {capability}")
        if capability not in capability_dependencies:
            fail(f"feature capability has no dependency declaration: {capability}")
        active.add(capability)
        result.add(capability)
        for dependency in capability_dependencies[capability]:
            visit(dependency)
        active.remove(capability)

    for feature in selected_features:
        if feature not in feature_capabilities:
            fail(f"feature has no capability declaration: {feature}")
        for capability in feature_capabilities[feature]:
            visit(capability)
    return result


def main() -> int:
    if len(sys.argv) != 6:
        print(
            f"usage: {sys.argv[0]} COMPAT_ROOT PINNED_SOURCE RUNTIME_SURFACE FEATURE_SURFACE OUTPUT",
            file=sys.stderr,
        )
        return 2

    root, pinned_source, runtime_surface_path, feature_surface_path, output = map(Path, sys.argv[1:])
    runtime_surface = read_json(runtime_surface_path)
    feature_surface = read_json(feature_surface_path)
    helper_capabilities = feature_surface.get("helperCapabilities")
    selected_features = feature_surface.get("selectedFeatures")
    selected_capabilities = feature_surface.get("selectedCapabilities")
    feature_capabilities = feature_surface.get("featureCapabilities")
    capability_dependencies = feature_surface.get("capabilityDependencies")
    roots = feature_surface.get("featureRoots")
    overrides = feature_surface.get("consumerFeatureOverrides", [])
    scanner_noise = feature_surface.get("scannerNoise", [])
    reference_noise = feature_surface.get("consumerReferenceNoise", [])
    external_capabilities = feature_surface.get("externalExecutableCapabilities")
    if (
        not isinstance(helper_capabilities, dict)
        or not isinstance(selected_features, list)
        or not all(isinstance(feature, str) for feature in selected_features)
        or not isinstance(selected_capabilities, list)
        or not all(isinstance(capability, str) for capability in selected_capabilities)
        or not isinstance(feature_capabilities, dict)
        or not all(isinstance(values, list) for values in feature_capabilities.values())
        or not all(
            isinstance(feature, str)
            and all(isinstance(capability, str) for capability in capabilities)
            for feature, capabilities in feature_capabilities.items()
        )
        or not isinstance(capability_dependencies, dict)
        or not all(isinstance(values, list) for values in capability_dependencies.values())
        or not all(
            isinstance(capability, str)
            and all(isinstance(dependency, str) for dependency in dependencies)
            for capability, dependencies in capability_dependencies.items()
        )
        or not all(isinstance(helper, str) and isinstance(capability, str) for helper, capability in helper_capabilities.items())
        or not isinstance(roots, list)
        or not all(isinstance(entry, dict) for entry in roots)
        or not isinstance(overrides, list)
        or not all(isinstance(entry, dict) for entry in overrides)
        or not isinstance(scanner_noise, list)
        or not all(isinstance(entry, dict) for entry in scanner_noise)
        or not isinstance(reference_noise, list)
        or not all(isinstance(entry, dict) for entry in reference_noise)
        or not isinstance(external_capabilities, dict)
        or not all(isinstance(capability, str) for capability in external_capabilities.values())
    ):
        fail("feature surface metadata is invalid")
    if any(
        not isinstance(entry.get("prefix"), str)
        or not isinstance(entry.get("feature"), str)
        or ("mixed" in entry and not isinstance(entry["mixed"], bool))
        for entry in roots
    ):
        fail("feature root identity is invalid")
    prefixes = [entry["prefix"] for entry in roots]
    if len(prefixes) != len(set(prefixes)):
        fail("duplicate feature root identity")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("feature"), str)
        or sum(isinstance(entry.get(kind), str) for kind in ("helper", "executable")) != 1
        or any(field in entry and not isinstance(entry[field], (str, int)) for field in ("id", "field", "line", "shape"))
        for entry in overrides
    ):
        fail("consumer feature override identity is invalid")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("helper"), str)
        or not isinstance(entry.get("exactLine"), str)
        or not isinstance(entry.get("reason"), str)
        or not entry["reason"]
        for entry in scanner_noise
    ):
        fail("scanner noise evidence identity is invalid")
    noise_keys = [(entry["path"], entry["helper"]) for entry in scanner_noise]
    if len(noise_keys) != len(set(noise_keys)):
        fail("duplicate scanner noise evidence identity")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("helper"), str)
        or not isinstance(entry.get("line"), str)
        for entry in reference_noise
    ):
        fail("consumer reference noise identity is invalid")

    selected = set(selected_features)
    selected_capability_set = resolve_capabilities(
        selected_features, feature_capabilities, capability_dependencies
    )
    if selected_capability_set != set(selected_capabilities):
        fail(
            "declared selected capabilities do not match feature capability closure: "
            f"declared={sorted(set(selected_capabilities))} derived={sorted(selected_capability_set)}"
        )
    all_source_paths = validate_source_inventory(root, roots)
    declared_source_paths: set[str] = set()
    for helper, entry in runtime_surface.items():
        if not isinstance(entry, dict):
            fail(f"runtime surface entry for {helper} is invalid")
        for source in entry.get("consumerSources", []):
            if isinstance(source, dict) and isinstance(source.get("path"), str):
                declared_source_paths.add(source["path"])
        consumer = entry.get("consumer")
        if isinstance(consumer, str):
            declared_source_paths.add(consumer)

    source_paths: set[str] = set()
    for relative in all_source_paths:
        feature = feature_for(relative, roots)
        if feature in selected:
            source_paths.add(relative)

    for relative in sorted(declared_source_paths):
        if not (root / relative).is_file():
            fail(f"declared post-patch consumer is missing: {relative}")
        feature = feature_for(relative, roots)
        if feature is None:
            fail(f"post-patch consumer has no feature identity: {relative}")
        if feature in selected:
            source_paths.add(relative)

    evidence: list[dict[str, object]] = []
    executable_evidence: list[dict[str, object]] = []
    for relative in sorted(source_paths):
        current = root / relative
        current_text = current.read_text(encoding="utf-8")
        feature = feature_for(relative, roots)
        if feature is None:
            fail(f"supported source has no feature identity: {relative}")
        root_entry = root_entry_for(relative, roots)
        if root_entry is None:
            fail(f"supported source has no root identity: {relative}")
        mixed = bool(root_entry.get("mixed", False))
        pinned = pinned_source / relative
        pinned_text = pinned.read_text(encoding="utf-8") if pinned.is_file() else ""
        lines = active_lines(current_text)

        helper_references: list[dict[str, object]] = []
        for line_number, line in enumerate(lines, 1):
            if HELPER_INVOCATION_PATTERN.search(line):
                for helper in HELPER_PATTERN.findall(line.replace("omarchy-menu.jsonc", "")):
                    helper_references.append(
                        {"name": helper, "line": line_number, "invocation": "source", "shape": line.strip()}
                    )
        if relative.endswith((".json", ".jsonc")):
            helper_references.extend(json_helpers(current_text))
            external_references = json_executables(relative, current_text)
        else:
            external_references = source_executables(relative, current_text)

        for noise in scanner_noise:
            if noise["path"] != relative:
                continue
            matching_lines = [line for line in lines if noise["helper"] in line]
            if matching_lines != [noise["exactLine"]]:
                fail(f"scanner noise evidence drifted for {relative}: {noise['helper']}")
        for noise in reference_noise:
            if noise["path"] != relative:
                continue
            if noise["line"] not in lines or noise["helper"] not in noise["line"]:
                fail(f"consumer reference noise evidence drifted for {relative}: {noise['helper']}")

        filtered_helpers: list[dict[str, object]] = []
        for reference in helper_references:
            helper = str(reference["name"])
            if any(
                noise["path"] == relative
                and noise["helper"] == helper
                and noise["line"] == lines[int(reference["line"]) - 1]
                for noise in reference_noise
            ):
                continue
            if noise_for(relative, helper, lines, scanner_noise):
                continue
            filtered_helpers.append(reference)

        helper_counts: dict[str, int] = {}
        for reference in filtered_helpers:
            helper_counts[str(reference["name"])] = helper_counts.get(str(reference["name"]), 0) + 1
        unknown_helpers = sorted(set(helper_counts) - set(helper_capabilities))
        if unknown_helpers:
            fail(
                f"{relative} references helpers without capability identities: "
                + ", ".join(unknown_helpers)
            )
        for reference in filtered_helpers:
            helper = str(reference["name"])
            helper_capability = helper_capabilities[helper]
            invocation_feature = consumer_feature_for(
                relative, "helper", helper, feature, reference, overrides, helper_counts[helper], mixed
            )
            if invocation_feature not in selected:
                fail(
                    f"{relative} ({invocation_feature}) references {helper}, "
                    "but the invocation feature is not selected"
                )
            if helper_capability not in selected_capability_set:
                fail(
                    f"{relative} ({invocation_feature}) requires {helper} ({helper_capability}), "
                    "but the selected runtime capabilities do not include it"
                )
            evidence.append(
                {
                    "consumer": relative,
                    "consumerFeature": invocation_feature,
                    "helper": helper,
                    "helperCapability": helper_capability,
                    "reference": reference,
                    "status": "pinned-reference" if helper in pinned_text else "post-patch-reference",
                }
            )

        executable_counts: dict[str, int] = {}
        for reference in external_references:
            name = str(reference["name"])
            executable_counts[name] = executable_counts.get(name, 0) + 1
        unknown_executables = sorted(set(executable_counts) - set(external_capabilities))
        if unknown_executables:
            fail(f"{relative} has unknown external executable: {', '.join(unknown_executables)}")
        for reference in external_references:
            executable = str(reference["name"])
            capability = external_capabilities[executable]
            invocation_feature = consumer_feature_for(
                relative,
                "executable",
                executable,
                feature,
                reference,
                overrides,
                executable_counts[executable],
                mixed,
            )
            if invocation_feature not in selected:
                fail(
                    f"{relative} ({invocation_feature}) references {executable}, "
                    "but the invocation feature is not selected"
                )
            if capability not in selected_capability_set:
                fail(
                    f"{relative} ({invocation_feature}) requires executable {executable} "
                    f"({capability}), but the selected runtime capabilities do not include it"
                )
            executable_evidence.append(
                {
                    "consumer": relative,
                    "consumerFeature": invocation_feature,
                    "executable": executable,
                    "capability": capability,
                    "reference": reference,
                }
            )

    Path(output).write_text(
        json.dumps(
            {
                "selectedFeatures": sorted(selected),
                "selectedCapabilities": sorted(selected_capability_set),
                "sourceCount": len(all_source_paths),
                "evidence": evidence,
                "executableEvidence": executable_evidence,
            },
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )
    print(
        "feature consumer closure passed "
        f"({len(evidence)} helper references, {len(executable_evidence)} executable references, "
        f"{len(all_source_paths)} audited sources)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
