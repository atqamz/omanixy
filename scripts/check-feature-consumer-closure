#!/usr/bin/env python3
"""Check feature closure against post-patch consumer source evidence."""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path


HELPER_PATTERN = re.compile(r"\bomarchy-[a-z0-9-]+\b")
SOURCE_SUFFIXES = {".qml", ".js", ".json", ".jsonc"}


def fail(message: str) -> None:
    print(f"feature consumer closure: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")
    if not isinstance(value, dict):
        fail(f"{path} is not an object")
    return value


def feature_for(path: str, roots: list[dict]) -> str | None:
    matches = [
        entry["feature"]
        for entry in roots
        if path == entry["prefix"].rstrip("/")
        or path.startswith(entry["prefix"])
    ]
    if len(matches) != 1:
        return None
    return matches[0]


def consumer_feature_for(
    path: str, kind: str, name: str, default: str, overrides: list[dict]
) -> str:
    matches = [
        entry["feature"]
        for entry in overrides
        if entry.get("path") == path and entry.get(kind) == name
    ]
    if len(matches) > 1:
        fail(f"duplicate consumer feature override for {path}: {kind}={name}")
    return matches[0] if matches else default


def closure(feature: str, dependencies: dict[str, list[str]]) -> set[str]:
    result: set[str] = set()
    active: set[str] = set()

    def visit(name: str) -> None:
        if name in result:
            return
        if name in active:
            fail(f"cyclic feature dependency at {name}")
        active.add(name)
        result.add(name)
        for dependency in dependencies.get(name, []):
            visit(dependency)
        active.remove(name)

    visit("core")
    visit(feature)
    return result


def active_lines(text: str) -> list[str]:
    lines: list[str] = []
    block_comment = False
    for line in text.splitlines():
        if block_comment:
            if "*/" in line:
                block_comment = False
            continue
        stripped = line.lstrip()
        if stripped.startswith("//"):
            continue
        if stripped.startswith("/*"):
            block_comment = "*/" not in stripped[2:]
            continue
        lines.append(line)
    return lines


def noise_for(
    path: str,
    helper: str,
    lines: list[str],
    scanner_noise: list[dict],
) -> bool:
    entries = [
        entry
        for entry in scanner_noise
        if entry["path"] == path and entry["helper"] == helper
    ]
    if not entries:
        return False
    if len(entries) != 1:
        fail(f"duplicate scanner noise evidence for {path}: {helper}")
    exact_line = entries[0]["exactLine"]
    matching_lines = [line for line in lines if helper in line]
    if matching_lines == [exact_line]:
        return True
    fail(f"scanner noise evidence drifted for {path}: {helper}")


def external_references(
    path: str, lines: list[str], external_features: dict[str, str]
) -> list[str]:
    references: list[str] = []
    for executable in sorted(external_features):
        direct_pattern = re.compile(
            r"(?:^|[\"']\s*)" + re.escape(executable) + r"(?=\s|[\"')]|$)"
        )
        token_pattern = re.compile(
            r"(?<![A-Za-z0-9_.+-])" + re.escape(executable) + r"(?![A-Za-z0-9_.+-])"
        )
        if path.endswith(".jsonc"):
            present = any(token_pattern.search(line) for line in lines)
        else:
            present = any(
                direct_pattern.search(line)
                or (
                    re.search(
                        r"\b(?:run|exec|command|script|action|when|checked|provider)\b|Quickshell|Util",
                        line,
                    )
                    and token_pattern.search(line)
                )
                for line in lines
            )
        if present:
            references.append(executable)
    return references


def main() -> int:
    if len(sys.argv) != 6:
        print(
            f"usage: {sys.argv[0]} COMPAT_ROOT PINNED_SOURCE RUNTIME_SURFACE FEATURE_SURFACE OUTPUT",
            file=sys.stderr,
        )
        return 2

    root, pinned_source, runtime_surface_path, feature_surface_path, output = map(Path, sys.argv[1:])
    runtime_surface = read_json(runtime_surface_path)
    feature_surface = read_json(feature_surface_path)
    helper_features = feature_surface.get("helperFeatures")
    selected_features = feature_surface.get("selectedFeatures")
    dependencies = feature_surface.get("dependencies")
    roots = feature_surface.get("featureRoots")
    overrides = feature_surface.get("consumerFeatureOverrides", [])
    scanner_noise = feature_surface.get("scannerNoise", [])
    reference_noise = feature_surface.get("consumerReferenceNoise", [])
    external_features = feature_surface.get("externalExecutableFeatures")
    if (
        not isinstance(helper_features, dict)
        or not isinstance(selected_features, list)
        or not all(isinstance(feature, str) for feature in selected_features)
        or not isinstance(dependencies, dict)
        or not isinstance(roots, list)
        or not all(isinstance(entry, dict) for entry in roots)
        or not isinstance(overrides, list)
        or not all(isinstance(entry, dict) for entry in overrides)
        or not isinstance(scanner_noise, list)
        or not all(isinstance(entry, dict) for entry in scanner_noise)
        or not isinstance(reference_noise, list)
        or not all(isinstance(entry, dict) for entry in reference_noise)
        or not isinstance(external_features, dict)
        or not all(isinstance(feature, str) for feature in external_features.values())
    ):
        fail("feature surface metadata is invalid")
    if any(
        not isinstance(entry.get("prefix"), str)
        or not isinstance(entry.get("feature"), str)
        for entry in roots
    ):
        fail("feature root identity is invalid")
    prefixes = [entry["prefix"] for entry in roots]
    if len(prefixes) != len(set(prefixes)):
        fail("duplicate feature root identity")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("feature"), str)
        or sum(isinstance(entry.get(kind), str) for kind in ("helper", "executable")) != 1
        for entry in overrides
    ):
        fail("consumer feature override identity is invalid")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("helper"), str)
        or not isinstance(entry.get("exactLine"), str)
        or not isinstance(entry.get("reason"), str)
        or not entry["reason"]
        for entry in scanner_noise
    ):
        fail("scanner noise evidence identity is invalid")
    noise_keys = [(entry["path"], entry["helper"]) for entry in scanner_noise]
    if len(noise_keys) != len(set(noise_keys)):
        fail("duplicate scanner noise evidence identity")
    if any(
        not isinstance(entry.get("path"), str)
        or not isinstance(entry.get("helper"), str)
        or not isinstance(entry.get("line"), str)
        for entry in reference_noise
    ):
        fail("consumer reference noise identity is invalid")

    selected = set(selected_features)
    selected_closures = {feature: closure(feature, dependencies) for feature in selected}
    evidence: list[dict[str, object]] = []
    executable_evidence: list[dict[str, object]] = []
    declared_source_paths: set[str] = set()
    for helper, entry in runtime_surface.items():
        if not isinstance(entry, dict):
            fail(f"runtime surface entry for {helper} is invalid")
        for source in entry.get("consumerSources", []):
            if isinstance(source, dict) and isinstance(source.get("path"), str):
                declared_source_paths.add(source["path"])
        consumer = entry.get("consumer")
        if isinstance(consumer, str):
            declared_source_paths.add(consumer)

    source_paths: set[str] = set()
    for root_entry in roots:
        prefix = root_entry["prefix"]
        feature = root_entry["feature"]
        if feature not in selected:
            continue
        source_root = root / prefix.rstrip("/")
        if source_root.is_file():
            candidates = [source_root]
        elif source_root.is_dir():
            candidates = sorted(
                path
                for path in source_root.rglob("*")
                if path.is_file() and path.suffix in SOURCE_SUFFIXES
            )
        else:
            fail(f"selected feature root is missing: {prefix}")
        for candidate in candidates:
            source_paths.add(str(candidate.relative_to(root)))

    for relative in sorted(declared_source_paths):
        if not (root / relative).is_file():
            fail(f"declared post-patch consumer is missing: {relative}")
        feature = feature_for(relative, roots)
        if feature is None:
            fail(f"post-patch consumer has no feature identity: {relative}")
        if feature in selected:
            source_paths.add(relative)

    for relative in sorted(source_paths):
        current = root / relative
        if not current.is_file():
            fail(f"declared post-patch consumer is missing: {relative}")
        if current.suffix not in SOURCE_SUFFIXES:
            fail(f"declared post-patch consumer has unsupported type: {relative}")
        try:
            current_text = current.read_text(encoding="utf-8")
        except OSError as error:
            fail(f"cannot read post-patch consumer {relative}: {error}")
        feature = feature_for(relative, roots)
        if feature is None:
            fail(f"supported source has no feature identity: {relative}")
        if feature not in selected:
            continue
        pinned = pinned_source / relative
        pinned_text = ""
        if pinned.is_file():
            try:
                pinned_text = pinned.read_text(encoding="utf-8")
            except OSError as error:
                fail(f"cannot read pinned consumer {relative}: {error}")
        lines = active_lines(current_text)
        discovered_helpers = set(
            helper
            for line in lines
            if "WlrLayershell.namespace" not in line
            for helper in HELPER_PATTERN.findall(line.replace("omarchy-menu.jsonc", ""))
        )
        for noise in reference_noise:
            if noise["path"] != relative or noise["helper"] not in discovered_helpers:
                continue
            matching_lines = [line for line in lines if noise["helper"] in line]
            if matching_lines and all(line == noise["line"] for line in matching_lines):
                discovered_helpers.remove(noise["helper"])
        for helper in sorted(discovered_helpers):
            if noise_for(relative, helper, lines, scanner_noise):
                discovered_helpers.remove(helper)
        unknown_helpers = sorted(discovered_helpers - set(helper_features))
        if unknown_helpers:
            fail(
                f"{relative} references helpers without feature identities: "
                + ", ".join(unknown_helpers)
            )
        for helper in sorted(discovered_helpers):
            helper_feature = helper_features[helper]
            if not isinstance(helper_feature, str):
                fail(f"helper feature identity is invalid: {helper}")
            invocation_feature = consumer_feature_for(relative, "helper", helper, feature, overrides)
            if invocation_feature not in selected:
                fail(
                    f"{relative} ({invocation_feature}) references {helper}, "
                    "but the invocation feature is not selected"
                )
            present_in_pinned = helper in pinned_text
            if helper_feature not in selected_closures[invocation_feature]:
                fail(
                    f"{relative} ({invocation_feature}) requires {helper} ({helper_feature}), "
                    "but the selected feature closure does not include it"
                )
            evidence.append(
                {
                    "consumer": relative,
                    "consumerFeature": invocation_feature,
                    "helper": helper,
                    "helperFeature": helper_feature,
                    "closure": sorted(selected_closures[invocation_feature]),
                    "status": "pinned-reference" if present_in_pinned else "post-patch-reference",
                }
            )

        for executable in external_references(relative, lines, external_features):
            executable_feature = external_features[executable]
            invocation_feature = consumer_feature_for(
                relative, "executable", executable, feature, overrides
            )
            if invocation_feature not in selected:
                fail(
                    f"{relative} ({invocation_feature}) references {executable}, "
                    "but the invocation feature is not selected"
                )
            if executable_feature != "host" and executable_feature not in selected_closures[invocation_feature]:
                fail(
                    f"{relative} ({invocation_feature}) requires executable {executable} "
                    f"({executable_feature}), but the selected feature closure does not include it"
                )
            executable_evidence.append(
                {
                    "consumer": relative,
                    "consumerFeature": invocation_feature,
                    "executable": executable,
                    "executableFeature": executable_feature,
                    "closure": sorted(selected_closures[invocation_feature]),
                }
            )

    output_path = Path(output)
    output_path.write_text(
        json.dumps(
            {
                "selectedFeatures": sorted(selected),
                "evidence": evidence,
                "executableEvidence": executable_evidence,
            },
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )
    print(
        "feature consumer closure passed "
        f"({len(evidence)} helper references, {len(executable_evidence)} executable references)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
