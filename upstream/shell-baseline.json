{
  "version": 1,
  "omanixyBaselineVersion": 2,
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {"id": "omarchy.menu"},
        {"id": "omarchy.workspaces"}
      ],
      "center": [
        {"id": "omarchy.clock", "format": "dddd HH:mm"},
        {"id": "omarchy.weather"}
      ],
      "right": [
        {"id": "omarchy.tray"},
        {"id": "omarchy.media"},
        {"id": "omarchy.bluetooth"},
        {"id": "omarchy.network"},
        {"id": "omarchy.audio"},
        {"id": "omarchy.monitor"},
        {"id": "omarchy.power"}
      ]
    }
  },
  "disabledPlugins": [
    "omarchy.active-window",
    "omarchy.agents",
    "omarchy.background",
    "omarchy.battery",
    "omarchy.dev-gallery",
    "omarchy.disk-speedtest",
    "omarchy.dropbox",
    "omarchy.idle",
    "omarchy.image-picker",
    "omarchy.indicators",
    "omarchy.keyboard-layout",
    "omarchy.lock",
    "omarchy.microphone",
    "omarchy.nightlight",
    "omarchy.notifications",
    "omarchy.polkit",
    "omarchy.reminders",
    "omarchy.system-update",
    "omarchy.tailscale"
  ],
  "featurePlugins": {
    "audio": ["omarchy.audio"],
    "bluetooth": ["omarchy.bluetooth"],
    "clipboard": ["omarchy.clipboard", "omarchy.emojis"],
    "monitor": ["omarchy.monitor"],
    "network": ["omarchy.network"],
    "power": ["omarchy.power"],
    "weather": ["omarchy.weather"]
  },
  "featureOrder": [
    "core",
    "audio",
    "bluetooth",
    "clipboard",
    "launcher",
    "monitor",
    "network",
    "notification",
    "power",
    "screenshot",
    "weather"
  ],
  "featureCapabilities": {
    "audio": ["audio-control", "audio-default-output"],
    "bluetooth": ["bluetooth-control", "audio-default-output"],
    "clipboard": ["clipboard-presentation"],
    "core": ["core-runtime"],
    "launcher": ["launcher"],
    "monitor": ["monitor-control"],
    "network": ["network-manager", "wayland-clipboard-write"],
    "notification": ["notification-send"],
    "power": ["power-control"],
    "screenshot": ["screenshot-capture", "wayland-clipboard-write", "notification-send"],
    "weather": ["weather-network", "notification-send"]
  },
  "capabilityDependencies": {
    "audio-control": ["core-runtime"],
    "audio-default-output": ["core-runtime"],
    "bluetooth-control": ["core-runtime"],
    "clipboard-presentation": ["core-runtime", "wayland-clipboard-write", "text-injection"],
    "core-runtime": [],
    "launcher": ["core-runtime"],
    "monitor-control": ["core-runtime"],
    "network-manager": ["core-runtime"],
    "notification-send": ["core-runtime"],
    "power-control": ["core-runtime"],
    "screenshot-capture": ["core-runtime"],
    "text-injection": ["core-runtime"],
    "wayland-clipboard-write": ["core-runtime"],
    "weather-network": ["core-runtime"]
  }
}
