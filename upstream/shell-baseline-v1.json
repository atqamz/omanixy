{
  "version": 1,
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {"id": "omarchy.menu"},
        {"id": "omarchy.workspaces"}
      ],
      "center": [
        {"id": "omarchy.clock", "format": "dddd HH:mm"}
      ],
      "right": []
    }
  },
  "disabledPlugins": [
    "omarchy.background",
    "omarchy.battery",
    "omarchy.clipboard",
    "omarchy.idle",
    "omarchy.lock",
    "omarchy.media",
    "omarchy.nightlight",
    "omarchy.notifications",
    "omarchy.polkit"
  ]
}
